# Example for proxy.env, the file the proxy SDK's setup-base hook reads from this directory.
# scripts/configure-proxy.sh writes proxy.env from the host's http_proxy, https_proxy and no_proxy;
# to write it by hand instead, copy this file to proxy.env and set your values.
# Without proxy.env (or with HTTP_PROXY_URL and HTTPS_PROXY_URL empty) workshops connect directly.
#
# HTTPS_PROXY_URL defaults to HTTP_PROXY_URL and the other way round.
# NO_PROXY_LIST defaults to localhost,127.0.0.0/8,10.0.0.0/8; keep those entries when you set it,
# because the workshops and the host talk over the workshopbr0 bridge.
HTTP_PROXY_URL='http://proxy.example.com:8080'
HTTPS_PROXY_URL='http://proxy.example.com:8080'
NO_PROXY_LIST='localhost,127.0.0.0/8,10.0.0.0/8,.example.com'
