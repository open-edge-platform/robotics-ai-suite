Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.5
    - Class: rviz_default_plugins/PointCloud2
      Name: Labeled points (label)
      Enabled: true
      Topic:
        Value: /segmentation/labeled_points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Channel Name: label
      Use rainbow: true
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 6
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacle points
      Enabled: true
      Topic:
        Value: /segmentation/obstacle_points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 0; 0
  Enabled: true
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Pitch: 0.6
      Yaw: 3.6
      Focal Point:
        X: 2
        Y: 0
        Z: 0
Window Geometry:
  Width: 1200
  Height: 800
