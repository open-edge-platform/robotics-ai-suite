<package format="3">
  <name>followme_turtlebot3_gazebo</name>
  <version>2.3.0</version>
  <description>
    This package is modified from Gazebo simulation package for the TurtleBot3.
    It adds a guide robot along with the turtlebot3 and activates depth camera for turtlebot.
    Supports Humble (Gazebo Fortress) and Jazzy (Gazebo Harmonic).
  </description>
  <maintainer email="eci.maintainer@intel.com">ECI Maintainer</maintainer>
  <license>Apache 2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <depend>ros_gz_sim</depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <exec_depend>adbscan_ros2_follow_me</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gz model_path="${prefix}/models"/>
    <ros_gz model_path="${prefix}/models"/>
  </export>
</package>
