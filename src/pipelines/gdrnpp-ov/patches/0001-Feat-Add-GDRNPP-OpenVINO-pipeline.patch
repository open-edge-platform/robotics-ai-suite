+        except Exception as e:
+            print(f"Warning: could not parse {score_file}: {e}")
+
+
+def parse_args():
+    p = argparse.ArgumentParser(description="Evaluate GDRNPP OpenVINO on BOP dataset")
+    p.add_argument("--yolox-model", default=None,
