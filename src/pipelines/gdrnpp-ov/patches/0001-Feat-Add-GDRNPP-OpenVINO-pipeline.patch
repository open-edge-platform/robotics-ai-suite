+#!/usr/bin/env python3
+"""
+Evaluate GDRNPP PyTorch pipeline on BOP dataset (e.g. LMO).
+
+Uses the same pre/post-processing as eval_openvino.py, but with PyTorch
+model inference instead of OpenVINO. This enables a direct accuracy
+comparison between PyTorch and OpenVINO pipelines.
+
+Runtime dependencies: numpy, opencv-python, torch, timm
+    (NO detectron2, mmcv — uses stub imports from export scripts)
+
+Usage:
+    python tools/openvino/eval_pytorch.py \
+        --yolox-ckpt output/yolox/.../model_final.pth \
+        --gdrn-ckpt output/gdrn/.../model_final_wo_optim.pth \
+        --dataset-dir datasets/BOP_DATASETS/lmo \
+        --output eval_output/lmo_pytorch
+"""
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+
+# Add tools/ to path
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from infer_utils import (
+    yolox_preproc,
+    decode_yolox_outputs,
+    yolox_postprocess,
+)
+from gdrnpp_ov_pipeline import (
+    prepare_gdrn_inputs,
+    gdrn_postprocess,
+    gdrn_postprocess_pnp,
+)
+from eval_bop_openvino import (
+    load_extents,
+    LMO_OBJ_IDS,
+    LMO_DEFAULT_K,
+)
+
+# ── Load YOLOX (reuse stubs from export script) ─────────────────────────
+from export_yolox_openvino import load_pytorch_model as load_yolox_model, detect_num_classes
+
+# ── Load GDRN (reuse stubs from export script) ──────────────────────────
+from export_gdrn_openvino import build_gdrn_from_checkpoint
+
+
+# =============================================================================
+# PyTorch Pipeline
+# =============================================================================
+
+class GDRNPPPipelinePyTorch:
+    """End-to-end GDRNPP pipeline using PyTorch (for accuracy comparison)."""
+
+    def __init__(self, yolox_model, gdrn_model, extents, cam_K,
+                 yolox_input_size=(640, 640), num_classes=8,
+                 conf_thr=0.3, nms_thr=0.45, dzi_pad_scale=1.5,
+                 use_pnp=True, mask_thr=0.5):
+        self.yolox = yolox_model
+        self.gdrn = gdrn_model
+        self.extents = extents
+        self.cam_K = cam_K
+        self.yolox_h, self.yolox_w = yolox_input_size
+        self.num_classes = num_classes
+        self.conf_thr = conf_thr
+        self.nms_thr = nms_thr
+        self.dzi_pad_scale = dzi_pad_scale
+        self.use_pnp = use_pnp
+        self.mask_thr = mask_thr
+
+    @torch.no_grad()
+    def __call__(self, image):
+        t0 = time.perf_counter()
+
+        # 1. YOLOX preprocessing
+        input_size = (self.yolox_h, self.yolox_w)
+        yolox_input, ratio = yolox_preproc(image, input_size)
+        yolox_tensor = torch.from_numpy(yolox_input[np.newaxis])
+
+        # 2. YOLOX inference (PyTorch)
+        raw_output = self.yolox(yolox_tensor).cpu().numpy()
+
+        # 3. Grid decode
+        decoded = decode_yolox_outputs(raw_output, input_size)
+
+        # 4. NMS
+        detections_list = yolox_postprocess(
+            decoded, self.num_classes,
+            conf_thr=self.conf_thr, nms_thr=self.nms_thr,
+        )
+        detections = detections_list[0]
+        t1 = time.perf_counter()
+
+        if detections is None or len(detections) == 0:
+            print(f"No detections (YOLOX: {(t1-t0)*1000:.1f}ms)")
+            return []
+
+        # 5. Prepare GDRN inputs
+        gdrn_inputs, meta = prepare_gdrn_inputs(
+            image, detections, ratio, self.cam_K, self.extents,
+            dzi_pad_scale=self.dzi_pad_scale,
+        )
+        t2 = time.perf_counter()
+
+        # 6. GDRN inference (PyTorch)
+        torch_inputs = (
+            torch.from_numpy(gdrn_inputs["image"]),
+            torch.from_numpy(gdrn_inputs["roi_classes"]),
+            torch.from_numpy(gdrn_inputs["roi_coord_2d"]),
+            torch.from_numpy(gdrn_inputs["roi_extents"]),
+        )
+        outputs = self.gdrn(*torch_inputs)
+        pred_rot = outputs[0].cpu().numpy()
+        pred_t = outputs[1].cpu().numpy()
+        t3 = time.perf_counter()
+
+        # 7. Post-process
+        if self.use_pnp and len(outputs) >= 6:
+            coor_x = outputs[2].cpu().numpy()
+            coor_y = outputs[3].cpu().numpy()
+            coor_z = outputs[4].cpu().numpy()
+            vis_mask = outputs[5].cpu().numpy()
+            poses = gdrn_postprocess_pnp(
+                pred_rot, pred_t, coor_x, coor_y, coor_z, vis_mask,
+                meta, mask_thr=self.mask_thr,
+            )
+        else:
+            poses = gdrn_postprocess(pred_rot, pred_t, meta)
+        t4 = time.perf_counter()
+
+        print(f"Detected {len(detections)} objects | "
+              f"YOLOX: {(t1-t0)*1000:.1f}ms, "
+              f"Crop: {(t2-t1)*1000:.1f}ms, "
+              f"GDRN: {(t3-t2)*1000:.1f}ms, "
+              f"Post: {(t4-t3)*1000:.1f}ms, "
+              f"Total: {(t4-t0)*1000:.1f}ms")
+
+        return poses
+
+
+# =============================================================================
+# Evaluation
+# =============================================================================
+
+def load_scene_data(dataset_dir, scene_id):
+    scene_dir = os.path.join(dataset_dir, "test", f"{scene_id:06d}")
+    with open(os.path.join(scene_dir, "scene_camera.json")) as f:
+        scene_camera = json.load(f)
+    return scene_camera
+
+
+def format_rotation(R):
+    return " ".join(f"{v}" for v in R.flatten().tolist())
+
+
+def format_translation(t):
+    t_mm = t * 1000.0
+    return " ".join(f"{v}" for v in t_mm.flatten().tolist())
+
+
+def run_evaluation(args):
+    dataset_dir = args.dataset_dir
+    project_root = Path(__file__).resolve().parent.parent.parent
+
+    # Load test targets
+    targets_path = os.path.join(dataset_dir, "lmo", "test_targets_bop19.json")
+    if not os.path.exists(targets_path):
+        targets_path = os.path.join(dataset_dir, "test_targets_bop19.json")
+    with open(targets_path) as f:
+        targets = json.load(f)
+    print(f"Loaded {len(targets)} evaluation targets")
+
+    target_map = {}
+    for t in targets:
