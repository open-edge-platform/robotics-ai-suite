+"""
+Pure numpy/cv2 utility functions for GDRNPP OpenVINO inference pipeline.
+
+Runtime dependencies are listed in requirements/requirements_deploy.txt.
+PyTorch, torchvision, mmcv and detectron2 are not required for inference.
+
+Each function documents its original source in the GDRNPP codebase for
+traceability. The implementations are numerically equivalent to the originals.
+"""
+
+import math
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+
+# =============================================================================
+# YOLOX Preprocessing
+# =============================================================================
+# Source: det/yolox/data/data_augment.py:preproc
+
+
+def yolox_preproc(img, input_size, swap=(2, 0, 1)):
+    """Letterbox resize with 114 padding for YOLOX.
+
+    Args:
+        img: BGR uint8 image (H, W, 3)
+        input_size: (height, width) network input size
+        swap: axis reorder, default (2,0,1) = HWC→CHW
+
+    Returns:
+        padded_img: (C, H, W) float32
+        ratio: scale factor applied
+    """
+    if len(img.shape) == 3:
+        padded_img = np.ones((input_size[0], input_size[1], 3), dtype=np.uint8) * 114
+    else:
+        padded_img = np.ones(input_size, dtype=np.uint8) * 114
+
+    ratio = min(input_size[0] / img.shape[0], input_size[1] / img.shape[1])
+    resized_img = cv2.resize(
+        img,
+        (int(img.shape[1] * ratio), int(img.shape[0] * ratio)),
+        interpolation=cv2.INTER_LINEAR,
+    ).astype(np.uint8)
+    padded_img[: int(img.shape[0] * ratio), : int(img.shape[1] * ratio)] = resized_img
+
+    padded_img = padded_img.transpose(swap)
+    padded_img = np.ascontiguousarray(padded_img, dtype=np.float32)
+    return padded_img, ratio
+
+
+# =============================================================================
+# YOLOX Grid Decode
+# =============================================================================
+# Source: det/yolox/models/yolo_head.py:decode_outputs
+
+
+def decode_yolox_outputs(raw_output, input_size=(640, 640), strides=(8, 16, 32)):
+    """Decode raw YOLOX output by applying grid offsets and stride scaling.
+
+    Args:
+        raw_output: (1, N, 5+num_classes) raw network output
+        input_size: (H, W) network input size
+        strides: feature map strides
+
+    Returns:
+        (1, N, 5+num_classes) ndarray with decoded boxes (cx, cy, w, h)
+    """
+    grids = []
+    strides_arr = []
+    for s in strides:
+        h, w = input_size[0] // s, input_size[1] // s
+        yv, xv = np.meshgrid(np.arange(h), np.arange(w), indexing="ij")
+        grid = np.stack((xv, yv), axis=-1).reshape(1, -1, 2).astype(np.float32)
+        grids.append(grid)
+        strides_arr.append(np.full((1, h * w, 1), s, dtype=np.float32))
+
+    grids = np.concatenate(grids, axis=1)
+    strides_arr = np.concatenate(strides_arr, axis=1)
+
+    output = raw_output.copy().astype(np.float32)
+    output[..., :2] = (output[..., :2] + grids) * strides_arr
+    output[..., 2:4] = np.exp(output[..., 2:4]) * strides_arr
+    return output
+
+
+# =============================================================================
+# YOLOX NMS Post-processing
+# =============================================================================
+# Source: det/yolox/utils/boxes.py:postprocess
+
+
+def _nms(boxes, scores, iou_thr):
+    """Single-class greedy NMS.  Matches det/yolox/utils/demo_utils.py:nms."""
+    x1, y1, x2, y2 = boxes[:, 0], boxes[:, 1], boxes[:, 2], boxes[:, 3]
+    areas = (x2 - x1 + 1) * (y2 - y1 + 1)
+    order = scores.argsort()[::-1]
+    keep = []
+    while order.size > 0:
+        i = order[0]
+        keep.append(i)
+        xx1 = np.maximum(x1[i], x1[order[1:]])
+        yy1 = np.maximum(y1[i], y1[order[1:]])
+        xx2 = np.minimum(x2[i], x2[order[1:]])
+        yy2 = np.minimum(y2[i], y2[order[1:]])
+        w = np.maximum(0.0, xx2 - xx1 + 1)
+        h = np.maximum(0.0, yy2 - yy1 + 1)
+        inter = w * h
+        ovr = inter / (areas[i] + areas[order[1:]] - inter)
+        inds = np.where(ovr <= iou_thr)[0]
+        order = order[inds + 1]
+    return keep
+
+
+def yolox_postprocess(decoded_output, num_classes, conf_thr=0.01, nms_thr=0.65):
+    """Post-process decoded YOLOX output: confidence filter + class-agnostic NMS.
+
+    Matches det/yolox/utils/boxes.py:postprocess with class_agnostic=True
+    (the mode used by det/yolox/tools/demo.py).
+
+    Args:
+        decoded_output: (1, N, 5+num_classes) decoded predictions (cx,cy,w,h,obj,cls...)
+        num_classes: number of object classes
+        conf_thr: confidence threshold (obj_conf * cls_conf)
+        nms_thr: NMS IoU threshold
+
+    Returns:
+        List[ndarray | None]: length = batch_size.  Each element is None
+        (no detections) or (M, 7) array: [x1, y1, x2, y2, obj_conf, cls_conf, cls_id].
+    """
+    batch_size = decoded_output.shape[0]
+    results = [None] * batch_size
+
+    for b in range(batch_size):
+        pred = decoded_output[b]  # (N, 5+C)
+
+        # xywh → xyxy
+        boxes = np.empty_like(pred[:, :4])
+        boxes[:, 0] = pred[:, 0] - pred[:, 2] / 2
+        boxes[:, 1] = pred[:, 1] - pred[:, 3] / 2
+        boxes[:, 2] = pred[:, 0] + pred[:, 2] / 2
+        boxes[:, 3] = pred[:, 1] + pred[:, 3] / 2
+
+        obj_conf = pred[:, 4]
+        cls_scores = pred[:, 5 : 5 + num_classes]
+        cls_ids = cls_scores.argmax(axis=1)
+        cls_conf = cls_scores[np.arange(len(cls_ids)), cls_ids]
+        scores = obj_conf * cls_conf
+
+        # Confidence filter
+        mask = scores >= conf_thr
+        boxes = boxes[mask]
+        obj_conf_f = obj_conf[mask]
+        cls_conf_f = cls_conf[mask]
+        cls_ids_f = cls_ids[mask]
+        scores_f = scores[mask]
+
+        if len(boxes) == 0:
+            continue
+
+        # Class-agnostic NMS (matches torchvision.ops.nms behavior)
+        keep = _nms(boxes, scores_f, nms_thr)
+
+        if not keep:
+            continue
+
+        keep = np.array(keep)
+
+        results[b] = np.column_stack([
+            boxes[keep],
+            obj_conf_f[keep, np.newaxis],
+            cls_conf_f[keep, np.newaxis],
+            cls_ids_f[keep, np.newaxis].astype(np.float32),
+        ])
+
+    return results
+
+
+# =============================================================================
+# Affine Crop Utilities
+# =============================================================================
+# Source: core/utils/data_utils.py
+
+
+def _get_3rd_point(a, b):
+    direct = a - b
+    return b + np.array([-direct[1], direct[0]], dtype=np.float32)
+
+
+def _get_dir(src_point, rot_rad):
+    sn, cs = np.sin(rot_rad), np.cos(rot_rad)
+    return [
+        src_point[0] * cs - src_point[1] * sn,
+        src_point[0] * sn + src_point[1] * cs,
+    ]
+
+
+def get_affine_transform(center, scale, rot, output_size,
+                         shift=np.array([0, 0], dtype=np.float32), inv=False):
+    """Compute 2x3 affine transform matrix.
+
+    Source: core/utils/data_utils.py:get_affine_transform
+
+    Args:
+        center: (cx, cy)
+        scale: (w, h) or scalar
+        rot: rotation angle in degrees
+        output_size: int or (w, h)
+        shift: translation shift
+        inv: if True, compute inverse transform
+    """
+    if isinstance(center, (tuple, list)):
+        center = np.array(center, dtype=np.float32)
+    if np.isscalar(scale) or (isinstance(scale, np.ndarray) and scale.ndim == 0):
+        scale = np.array([float(scale), float(scale)], dtype=np.float32)
+    elif isinstance(scale, (tuple, list)):
+        scale = np.array(scale, dtype=np.float32)
+    if isinstance(output_size, (int, float)):
+        output_size = (output_size, output_size)
+
+    src_w = scale[0]
+    dst_w, dst_h = output_size
+
+    rot_rad = np.pi * rot / 180
+    src_dir = _get_dir([0, src_w * -0.5], rot_rad)
+    dst_dir = np.array([0, dst_w * -0.5], np.float32)
+
+    src = np.zeros((3, 2), dtype=np.float32)
+    dst = np.zeros((3, 2), dtype=np.float32)
+    src[0, :] = center + scale * shift
+    src[1, :] = center + src_dir + scale * shift
+    dst[0, :] = [dst_w * 0.5, dst_h * 0.5]
+    dst[1, :] = np.array([dst_w * 0.5, dst_h * 0.5], np.float32) + dst_dir
+
+    src[2:, :] = _get_3rd_point(src[0, :], src[1, :])
+    dst[2:, :] = _get_3rd_point(dst[0, :], dst[1, :])
+
+    if inv:
+        return cv2.getAffineTransform(np.float32(dst), np.float32(src))
+    else:
+        return cv2.getAffineTransform(np.float32(src), np.float32(dst))
+
+
+def crop_resize_by_warp_affine(img, center, scale, output_size, rot=0,
+                                interpolation=cv2.INTER_LINEAR):
+    """Crop and resize image region using affine warp.
+
+    Source: core/utils/data_utils.py:crop_resize_by_warp_affine
+    """
+    if isinstance(scale, (int, float)):
+        scale = (scale, scale)
+    if isinstance(output_size, int):
+        output_size = (output_size, output_size)
+    trans = get_affine_transform(center, scale, rot, output_size)
+    return cv2.warpAffine(img, trans, (int(output_size[0]), int(output_size[1])),
+                          flags=interpolation)
+
+
+# =============================================================================
+# 2D Coordinate Map
+# =============================================================================
+# Source: core/utils/data_utils.py:get_2d_coord_np
+
+
+def get_2d_coord_np(width, height, low=0, high=1, fmt="CHW", endpoint=False):
+    """Generate 2D coordinate map.
+
+    Args:
+        width, height: map dimensions
+        low, high: coordinate value range
+        fmt: "CHW" → (2, H, W), "HWC" → (H, W, 2)
+
+    Returns:
+        xy coordinate map as float32 ndarray
+    """
+    x = np.linspace(low, high, width, dtype=np.float32, endpoint=endpoint)
+    y = np.linspace(low, high, height, dtype=np.float32, endpoint=endpoint)
+    xy = np.asarray(np.meshgrid(x, y))
+    if fmt == "HWC":
+        xy = xy.transpose(1, 2, 0)
+    elif fmt == "CHW":
+        pass
+    else:
+        raise ValueError(f"Unknown format: {fmt}")
+    return xy
+
+
+# =============================================================================
+# Rotation: 6D → Rotation Matrix
+# =============================================================================
+# Source: core/utils/rot_reps.py:rot6d_to_mat_batch
+# Reference: Zhou et al., "On the Continuity of Rotation Representations
+#            in Neural Networks", CVPR 2019.
+
+
+def rot6d_to_mat_batch(d6):
+    """Convert 6D rotation representation to 3x3 rotation matrices.
+
+    Args:
+        d6: (*, 6) array
+
+    Returns:
+        (*, 3, 3) rotation matrices
+    """
+    x_raw = d6[..., 0:3]
+    y_raw = d6[..., 3:6]
+
+    x = x_raw / (np.linalg.norm(x_raw, axis=-1, keepdims=True) + 1e-12)
+    z = np.cross(x, y_raw)
+    z = z / (np.linalg.norm(z, axis=-1, keepdims=True) + 1e-12)
+    y = np.cross(z, x)
+
+    return np.stack((x, y, z), axis=-1)  # (*, 3, 3)
+
+
+# =============================================================================
+# Allocentric → Egocentric Rotation
+# =============================================================================
+# Source: lib/pysixd/RT_transform.py:allocentric_to_egocentric
+# Rodrigues' formula replaces transforms3d.axangles.axangle2mat
+
+
+def _axangle2mat(axis, angle):
+    """Axis-angle to rotation matrix via Rodrigues' formula.
+
+    Replaces transforms3d.axangles.axangle2mat — no external dependency.
+    """
+    axis = np.asarray(axis, dtype=np.float64)
+    norm = np.linalg.norm(axis)
+    if norm < 1e-12:
+        return np.eye(3, dtype=np.float64)
+    axis = axis / norm
+    K = np.array([
+        [0, -axis[2], axis[1]],
+        [axis[2], 0, -axis[0]],
+        [-axis[1], axis[0], 0],
+    ], dtype=np.float64)
+    return np.eye(3) + math.sin(angle) * K + (1 - math.cos(angle)) * (K @ K)
+
+
+def allocentric_to_egocentric(allo_pose, src_type="mat", dst_type="mat"):
+    """Convert allocentric (object-centric) pose to egocentric (camera-centric).
+
+    Source: lib/pysixd/RT_transform.py:allocentric_to_egocentric
+
+    Args:
+        allo_pose: (3, 4) pose matrix [R|t] when src_type="mat"
+        src_type: "mat" (other types not supported in this lightweight version)
+        dst_type: "mat"
+
+    Returns:
+        (3, 4) egocentric pose matrix [R|t]
+    """
+    if src_type != "mat" or dst_type != "mat":
+        raise NotImplementedError(
+            f"Only mat→mat is supported, got {src_type}→{dst_type}. "
+            "Use lib/pysixd/RT_transform.py for quat support."
+        )
+
+    cam_ray = np.array([0, 0, 1.0])
+    trans = allo_pose[:3, 3]
+    obj_ray = trans.copy() / np.linalg.norm(trans)
+    angle = math.acos(cam_ray.dot(obj_ray))
+
+    if angle > 0:
+        ego_pose = np.zeros((3, 4), dtype=allo_pose.dtype)
+        ego_pose[:3, 3] = trans
+        rot_mat = _axangle2mat(axis=np.cross(cam_ray, obj_ray), angle=angle)
+        ego_pose[:3, :3] = rot_mat.astype(allo_pose.dtype) @ allo_pose[:3, :3]
+    else:
+        ego_pose = allo_pose.copy()
+
+    return ego_pose
+
+
+# =============================================================================
+# PnP RANSAC Utilities
+# =============================================================================
+# Source: core/gdrn_modeling/engine/engine_utils.py (get_out_coor, get_out_mask)
+#         core/gdrn_modeling/engine/gdrn_evaluator.py (get_img_model_points_with_coords2d)
+#         lib/pysixd/misc.py (pnp_v2)
+
+
+def get_out_coor(coor_x, coor_y, coor_z, xyz_bin=0):
+    """Combine predicted coordinate maps into a single (B, 3, H, W) array.
+
+    Source: core/gdrn_modeling/engine/engine_utils.py:get_out_coor
+
+    Args:
+        coor_x, coor_y, coor_z: each (B, C, H, W).
+            If C == 1 (L1 loss): direct regression output, just concatenate.
+            If C > 1 (CE loss): classification output, apply argmax + normalize.
+        xyz_bin: bin count for CE loss type (cfg.MODEL.POSE_NET.GEO_HEAD.XYZ_BIN).
+
+    Returns:
+        (B, 3, H, W) float32 coordinate map in [0, 1] range.
+    """
+    if coor_x.shape[1] == 1 and coor_y.shape[1] == 1 and coor_z.shape[1] == 1:
+        return np.concatenate([coor_x, coor_y, coor_z], axis=1)
+    else:
+        coor = np.stack([
+            np.argmax(coor_x, axis=1),
+            np.argmax(coor_y, axis=1),
+            np.argmax(coor_z, axis=1),
+        ], axis=1).astype(np.float32)
+        coor[coor == xyz_bin] = 0
+        coor = coor / float(xyz_bin - 1)
+        return coor
+
+
+def get_out_mask(pred_mask, mask_loss_type="L1"):
+    """Normalize predicted mask to [0, 1].
+
+    Source: core/gdrn_modeling/engine/engine_utils.py:get_out_mask
+
+    Args:
+        pred_mask: (B, C, H, W). For L1: C=1, for CE: C>1.
+        mask_loss_type: "L1", "BCE", "CE", etc.
+
+    Returns:
+        (B, 1, H, W) float32 mask in [0, 1].
+    """
+    if mask_loss_type == "L1":
+        bs = pred_mask.shape[0]
+        flat = pred_mask.reshape(bs, -1)
+        mask_max = flat.max(axis=-1).reshape(bs, 1, 1, 1)
+        mask_min = flat.min(axis=-1).reshape(bs, 1, 1, 1)
+        return (pred_mask - mask_min) / (mask_max - mask_min)
+    elif mask_loss_type in ("BCE", "RW_BCE", "dice"):
+        return 1.0 / (1.0 + np.exp(-pred_mask))  # sigmoid
+    elif mask_loss_type == "CE":
+        return np.argmax(pred_mask, axis=1, keepdims=True).astype(np.float32)
+    else:
+        raise ValueError(f"Unknown mask loss type: {mask_loss_type}")
+
+
+def get_img_model_points_with_coords2d(mask_pred_crop, xyz_pred_crop, coord2d_crop,
+                                        im_H, im_W, extent, mask_thr=0.5):
+    """Extract 2D-3D correspondences from predicted xyz/mask crops.
+
+    Source: core/gdrn_modeling/engine/gdrn_evaluator.py:get_img_model_points_with_coords2d
+
+    Args:
+        mask_pred_crop: (H, W) predicted mask in roi_size
+        xyz_pred_crop: (H, W, 3) predicted xyz in roi_size, values in [0, 1]
+        coord2d_crop: (H, W, 2) 2D coords in roi_size, values in [0, 1]
+        im_H, im_W: original image dimensions
+        extent: (3,) object 3D extent (size_x, size_y, size_z)
+        mask_thr: mask threshold (default 0.5)
+
+    Returns:
+        image_points: (M, 2) 2D image points
+        model_points: (M, 3) 3D model points
+    """
+    # [0, 1] → [-0.5, 0.5] → original scale
+    xyz = xyz_pred_crop.copy()
+    xyz[:, :, 0] = (xyz[:, :, 0] - 0.5) * extent[0]
+    xyz[:, :, 1] = (xyz[:, :, 1] - 0.5) * extent[1]
+    xyz[:, :, 2] = (xyz[:, :, 2] - 0.5) * extent[2]
+
+    coord2d = coord2d_crop.copy()
+    coord2d[:, :, 0] = coord2d[:, :, 0] * im_W
+    coord2d[:, :, 1] = coord2d[:, :, 1] * im_H
+
+    sel_mask = (
+        (mask_pred_crop > mask_thr)
+        & (np.abs(xyz[:, :, 0]) > 0.0001 * extent[0])
+        & (np.abs(xyz[:, :, 1]) > 0.0001 * extent[1])
+        & (np.abs(xyz[:, :, 2]) > 0.0001 * extent[2])
+    )
+    model_points = xyz[sel_mask].reshape(-1, 3)
+    image_points = coord2d[sel_mask].reshape(-1, 2)
+
+    return image_points, model_points
+
+
+def get_K_crop_resize(K, bbox_center, scale, output_res):
+    """Compute intrinsic matrix for a crop-and-resize ROI.
+
+    Source: core/utils/camera_geometry.py:get_K_crop_resize
+            core/gdrn_modeling/engine/engine_utils.py:batch_data_inference_roi
+
+    Args:
+        K: (3, 3) original camera intrinsic matrix
+        bbox_center: (2,) center of the bounding box (cx, cy)
+        scale: scalar, max(bw, bh) * dzi_pad_scale
+        output_res: int, output resolution (e.g. 64)
+
+    Returns:
+        (3, 3) intrinsic matrix adjusted for the crop
+    """
+    crop_xy = bbox_center - scale / 2.0  # top-left of crop
+    resize_ratio = output_res / scale
+
+    new_K = K.copy()
+    new_K[0, 2] = (K[0, 2] - crop_xy[0]) * resize_ratio
+    new_K[1, 2] = (K[1, 2] - crop_xy[1]) * resize_ratio
+    new_K[0, 0] = K[0, 0] * resize_ratio
+    new_K[0, 1] = K[0, 1] * resize_ratio
+    new_K[1, 0] = K[1, 0] * resize_ratio
+    new_K[1, 1] = K[1, 1] * resize_ratio
+    return new_K
+
+
+# =============================================================================
+# PLY Model Loader (lightweight, no pysixd dependency)
+# =============================================================================
+
+
+def load_ply(path, vertex_scale=1.0):
+    """Load a PLY mesh model (vertices + faces).
+
+    Lightweight reimplementation of lib/pysixd/inout.py:load_ply.
+    Supports ASCII and binary_little_endian PLY files from BOP datasets.
+
+    Args:
+        path: path to .ply file
+        vertex_scale: scale factor for vertex coordinates (e.g. 0.001 for mm→m)
+
+    Returns:
+        dict with 'pts' (Nx3 float32) and 'faces' (Mx3 int32)
+    """
+    import struct
+
+    with open(path, "rb") as f:
+        # Parse header
+        n_pts = 0
+        n_faces = 0
+        is_binary = False
+        pt_props = []
+        in_vertex = False
+        in_face = False
+
+        while True:
+            line = f.readline().decode("utf-8", errors="replace").strip()
+            if line.startswith("format binary"):
+                is_binary = True
+            elif line.startswith("format ascii"):
+                is_binary = False
+            elif line.startswith("element vertex"):
+                n_pts = int(line.split()[-1])
+                in_vertex = True
+                in_face = False
+            elif line.startswith("element face"):
+                n_faces = int(line.split()[-1])
+                in_vertex = False
+                in_face = True
+            elif line.startswith("element"):
+                in_vertex = False
+                in_face = False
+            elif line.startswith("property") and in_vertex and "list" not in line:
+                dtype_str = line.split()[-2]
+                pt_props.append(dtype_str)
+            elif line == "end_header":
+                break
+
+        # Map PLY types to struct format and numpy dtype
+        _ply_to_struct = {
+            "float": "f", "float32": "f",
+            "double": "d", "float64": "d",
+            "uchar": "B", "uint8": "B",
+            "char": "b", "int8": "b",
+            "ushort": "H", "uint16": "H",
+            "short": "h", "int16": "h",
+            "uint": "I", "uint32": "I",
+            "int": "i", "int32": "i",
+        }
+
+        if is_binary:
+            # Build vertex struct format
+            vert_fmt = "<" + "".join(_ply_to_struct.get(p, "f") for p in pt_props)
+            vert_size = struct.calcsize(vert_fmt)
+
+            pts = np.zeros((n_pts, 3), dtype=np.float32)
+            for i in range(n_pts):
+                vals = struct.unpack(vert_fmt, f.read(vert_size))
+                pts[i] = vals[:3]
+
+            faces = np.zeros((n_faces, 3), dtype=np.int32)
+            for i in range(n_faces):
+                n_corners = struct.unpack("<B", f.read(1))[0]
+                idx = struct.unpack(f"<{n_corners}i", f.read(4 * n_corners))
+                faces[i] = idx[:3]
+        else:
+            pts = np.zeros((n_pts, 3), dtype=np.float32)
+            for i in range(n_pts):
+                vals = f.readline().decode("utf-8", errors="replace").split()
+                pts[i] = [float(vals[0]), float(vals[1]), float(vals[2])]
+
+            faces = np.zeros((n_faces, 3), dtype=np.int32)
+            for i in range(n_faces):
+                vals = f.readline().decode("utf-8", errors="replace").split()
+                faces[i] = [int(vals[1]), int(vals[2]), int(vals[3])]
+
+    pts *= vertex_scale
+    return {"pts": pts, "faces": faces}
+
+
+# =============================================================================
+# Depth Renderer (EGL preferred, CPU fallback)
+# =============================================================================
+
+
+class DepthRenderer:
+    """Render depth maps for depth-based pose refinement.
+
+    Tries EGL renderer (GPU-accelerated, per-pixel interpolation) first.
+    Falls back to CPU rasterization (numpy/cv2, per-triangle Z) if EGL
+    is unavailable.
+    """
+
+    def __init__(self, ply_paths, vertex_scale=0.001, width=64, height=64, gpu_id=0):
+        """
+        Args:
+            ply_paths: dict mapping cls_index → PLY file path
+            vertex_scale: scale factor for vertices (0.001 = mm→m)
+            width, height: render resolution (typically output_res=64)
+            gpu_id: GPU device index for EGL
+        """
+        self.width = width
+        self.height = height
+        self._egl_renderer = None
+        self._egl_model_ids = {}  # cls_index → egl obj_id
+        self._cpu_models = {}     # cls_index → {'pts', 'faces'}
+        self._backend = "cpu"
+
+        # Try EGL first
+        try:
+            self._init_egl(ply_paths, vertex_scale, gpu_id)
+            self._backend = "egl"
+            print(f"DepthRenderer: using EGL backend ({width}x{height})")
+        except Exception as e:
+            print(f"DepthRenderer: EGL unavailable ({e}), using CPU fallback")
+            self._init_cpu(ply_paths, vertex_scale)
+
+    def _init_egl(self, ply_paths, vertex_scale, gpu_id):
+        """Initialize EGL renderer."""
+        import os
+        os.environ["PYOPENGL_PLATFORM"] = "egl"
+
+        # Import from project root
+        import sys
+        project_root = str(Path(__file__).resolve().parent.parent.parent)
+        if project_root not in sys.path:
+            sys.path.insert(0, project_root)
+
+        from lib.egl_renderer.egl_renderer import EGLRenderer
+
+        # EGLRenderer identifies objects by the index into its model_paths
+        # kwarg. We keep a stable mapping cls_index → egl_index for render().
+        sorted_cls = sorted(ply_paths.keys())
+        all_paths = [ply_paths[c] for c in sorted_cls]
+
+        self._egl_renderer = EGLRenderer(
+            model_paths=all_paths,
+            K=None,
+            width=self.width,
+            height=self.height,
+            gpu_id=gpu_id,
+            vertex_scale=vertex_scale,
+            znear=0.01,
+            zfar=10.0,
+            robot="",  # skip robot pose offset loading (panda_arm default)
+        )
+        self._egl_model_ids = {cls_idx: egl_idx
+                               for egl_idx, cls_idx in enumerate(sorted_cls)}
+
+    def _init_cpu(self, ply_paths, vertex_scale):
+        """Load models for CPU rendering."""
+        for cls_idx, path in ply_paths.items():
+            self._cpu_models[cls_idx] = load_ply(path, vertex_scale=vertex_scale)
+
+    def render(self, cls_index, pose, K):
+        """Render depth map for one object.
+
+        Args:
+            cls_index: class index of the object
+            pose: (3, 4) [R | t] pose matrix
+            K: (3, 3) camera intrinsic matrix
+
+        Returns:
+            depth: (height, width) float32 depth map (0 = background)
+        """
+        if self._backend == "egl":
+            return self._render_egl(cls_index, pose, K)
+        else:
+            return _render_depth_cpu(
+                self._cpu_models[cls_index], pose, K,
+                self.height, self.width,
+            )
+
+    def _render_egl(self, cls_index, pose, K):
+        """Render depth via EGL renderer."""
+        pc_cam_tensor = np.empty(
+            (self.height, self.width, 4), dtype=np.float32,
+        )
+        self._egl_renderer.render(
+            obj_ids=[self._egl_model_ids[cls_index]],
+            poses=[pose],
+            K=K,
+            rot_type="mat",
+            pc_cam_tensor=pc_cam_tensor,
+            to_bgr=False,
+            to_255=False,
+        )
+        depth = pc_cam_tensor[:, :, 2]
+        # EGL depth: positive = valid, 0 or negative = background
+        depth[depth <= 0] = 0.0
+        return depth.astype(np.float32)
+
+    def close(self):
+        if self._egl_renderer is not None:
+            self._egl_renderer.close()
+
+    @property
+    def backend(self):
+        return self._backend
+
+
+def _render_depth_cpu(model, pose, K, height, width, clip_near=0.01, clip_far=10.0):
+    """CPU fallback: render depth via triangle rasterization.
+
+    Uses per-triangle mean depth (approximate). Acceptable for the small
+    output_res (64x64) used in depth refinement.
+
+    Args:
+        model: dict with 'pts' (Nx3) and 'faces' (Mx3)
+        pose: (3, 4) [R | t] pose matrix
+        K: (3, 3) camera intrinsic matrix
+        height, width: output image size
+        clip_near, clip_far: depth clipping range
+
+    Returns:
+        depth: (height, width) float32 depth map (0 = background)
+    """
+    pts = model["pts"]  # (N, 3)
+    faces = model["faces"]  # (M, 3)
+
+    # Transform to camera frame
+    R = pose[:3, :3]
+    t = pose[:3, 3]
+    pts_cam = (R @ pts.T + t.reshape(3, 1)).T  # (N, 3)
+
+    # Project to 2D
+    pts_2d_h = (K @ pts_cam.T).T  # (N, 3)
+    z_vals = pts_2d_h[:, 2]
+
+    valid = z_vals > clip_near
+    pts_2d = np.zeros((len(pts), 2), dtype=np.float32)
+    pts_2d[valid, 0] = pts_2d_h[valid, 0] / z_vals[valid]
+    pts_2d[valid, 1] = pts_2d_h[valid, 1] / z_vals[valid]
+
+    # Initialize depth buffer
+    depth = np.full((height, width), np.inf, dtype=np.float32)
+
+    for face in faces:
+        v0, v1, v2 = face
+        zs = z_vals[[v0, v1, v2]]
+
+        if np.any(zs <= clip_near) or np.any(zs >= clip_far):
+            continue
+
+        tri_pts = pts_2d[[v0, v1, v2]].astype(np.int32)
+
+        x_min, y_min = tri_pts.min(axis=0)
+        x_max, y_max = tri_pts.max(axis=0)
+        if x_max < 0 or y_max < 0 or x_min >= width or y_min >= height:
+            continue
+
+        z_mean = zs.mean()
+
+        mask = np.zeros((height, width), dtype=np.uint8)
+        cv2.fillConvexPoly(mask, tri_pts.reshape(-1, 1, 2), 1)
+
+        update = (mask > 0) & (z_mean < depth)
+        depth[update] = z_mean
+
+    depth[depth == np.inf] = 0.0
+    return depth
+
+
+# =============================================================================
+# Depth-based Pose Refinement
+# =============================================================================
+# Source: core/gdrn_modeling/engine/gdrn_evaluator.py:process_depth_refine
+
+
+def depth_refine_pose(rot_est, trans_est, xyz_pred, mask_pred,
+                      depth_sensor_crop, K_crop, depth_renderer, cls_index,
+                      output_res=64, n_iter=2, threshold=0.8):
+    """Refine pose translation using sensor depth.
+
+    Iteratively renders the object at the current pose, compares rendered
+    depth with observed sensor depth, and adjusts translation along the
+    camera ray. Only translation is refined; rotation is kept fixed.
+
+    Source: core/gdrn_modeling/engine/gdrn_evaluator.py:process_depth_refine
+
+    Args:
+        rot_est: (3, 3) estimated rotation matrix
+        trans_est: (3,) estimated translation vector (meters)
+        xyz_pred: (H, W, 3) predicted XYZ coordinates in [0, 1]
+        mask_pred: (H, W) predicted mask in [0, 1]
+        depth_sensor_crop: (H, W) sensor depth cropped and resized to output_res
+        K_crop: (3, 3) intrinsic matrix for the crop
+        depth_renderer: DepthRenderer instance
+        cls_index: class index of the object
+        output_res: int, crop resolution (default 64)
+        n_iter: number of refinement iterations (default 2)
+        threshold: confidence threshold as fraction of max (default 0.8)
+
+    Returns:
+        refined_trans: (3,) refined translation vector
+    """
+    trans = trans_est.copy()
+    depth_sensor_mask = depth_sensor_crop > 0
+    crop_res = output_res
+
+    for _ in range(n_iter):
+        pose_est = np.hstack([rot_est, trans.reshape(3, 1)])
+
+        # Render depth at current pose
+        ren_dp = depth_renderer.render(cls_index, pose_est, K_crop)
+        ren_mask = ren_dp > 0
+
+        # Compute confidence map: L2 norm of predicted XYZ, masked
+        query_img_norm = np.linalg.norm(xyz_pred, axis=-1) * mask_pred
+        query_img_norm = query_img_norm * ren_mask * depth_sensor_mask
+
+        norm_sum = query_img_norm.sum()
+        if norm_sum == 0:
+            continue
+        query_img_norm /= norm_sum
+
+        # Select high-confidence pixels
+        norm_mask = query_img_norm > (query_img_norm.max() * threshold)
+        yy, xx = np.argwhere(norm_mask).T  # 2 x (N,)
+
+        if len(yy) == 0:
+            continue
+
+        # Depth adjustment = median(sensor_depth - rendered_depth)
+        depth_diff = depth_sensor_crop[yy, xx] - ren_dp[yy, xx]
+        depth_adjustment = np.median(depth_diff)
+
+        # Compute weighted ray direction
+        yx_coords = np.meshgrid(np.arange(crop_res), np.arange(crop_res))
+        yx_coords = np.stack(yx_coords[::-1], axis=-1)  # (H, W, 2) in (y, x) order
+        yx_ray_2d = (yx_coords * query_img_norm[..., None]).sum(axis=(0, 1))  # (y, x)
+        ray_3d = np.linalg.inv(K_crop) @ np.array([yx_ray_2d[1], yx_ray_2d[0], 1.0])
+        ray_3d /= ray_3d[2]
+
+        # Update translation
+        trans_delta = ray_3d * depth_adjustment
+        trans = trans + trans_delta.astype(trans.dtype)
+
+    return trans
+
+
+def pnp_v2(points_3d, points_2d, camera_matrix,
+            method=cv2.SOLVEPNP_EPNP, ransac=True,
+            ransac_reprojErr=3.0, ransac_iter=100):
+    """Solve PnP with optional RANSAC.
+
+    Source: lib/pysixd/misc.py:pnp_v2
+
+    Args:
+        points_3d: (N, 3) 3D model points
+        points_2d: (N, 2) 2D image points
+        camera_matrix: (3, 3) intrinsic matrix
+        method: cv2 PnP method (default SOLVEPNP_EPNP)
+        ransac: use RANSAC (default True)
+        ransac_reprojErr: RANSAC reprojection error threshold
+        ransac_iter: RANSAC max iterations
+
+    Returns:
+        (3, 4) pose matrix [R | t], or None if solver fails.
+    """
+    dist_coeffs = np.zeros((8, 1), dtype=np.float64)
+
+    if method == cv2.SOLVEPNP_EPNP:
+        points_3d = np.expand_dims(points_3d, 0)
+        points_2d = np.expand_dims(points_2d, 0)
+
+    points_2d = np.ascontiguousarray(points_2d.astype(np.float64))
+    points_3d = np.ascontiguousarray(points_3d.astype(np.float64))
+    camera_matrix = camera_matrix.astype(np.float64)
+
+    if not ransac:
+        ret, R_exp, t = cv2.solvePnP(
+            points_3d, points_2d, camera_matrix, dist_coeffs, flags=method
+        )
+    else:
+        ret, R_exp, t, inliers = cv2.solvePnPRansac(
+            points_3d, points_2d, camera_matrix, dist_coeffs,
+            flags=method,
+            reprojectionError=ransac_reprojErr,
+            iterationsCount=ransac_iter,
+        )
+
+    if not ret:
+        return None
+
+    R, _ = cv2.Rodrigues(R_exp)
+    return np.concatenate([R, t.reshape(3, 1)], axis=-1)
