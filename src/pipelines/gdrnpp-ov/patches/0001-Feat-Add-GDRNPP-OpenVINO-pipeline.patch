+#!/usr/bin/env python3
+"""
+Export YOLOX model from PyTorch to OpenVINO IR format
+
+This script converts trained YOLOX detection models to OpenVINO IR format
+for optimized inference on Intel CPUs and GPUs.
+
+Usage:
+    python tools/openvino/export_yolox_openvino.py \
+        --ckpt output/yolox/bop_pbr/yolox_x_640_augCozyAAEhsv_ranger_30_epochs_lmo_pbr_lmo_bop_test/model_final.pth \
+        --output models/openvino/yolox_lmo
+"""
+
+import argparse
+import importlib
+import importlib.util
+import os
+import sys
+import types
+from pathlib import Path
+from loguru import logger
+
+import torch
+import torch.nn as nn
+import numpy as np
+
+# Add project root to path
+project_root = Path(__file__).resolve().parent.parent.parent
+sys.path.insert(0, str(project_root))
+
+# Pre-register package stubs to prevent __init__.py from importing
+# problematic dependencies (detectron2, mmcv, etc.)
+# Set __path__ to actual directories so relative imports resolve correctly.
+_stub_packages = {
+    "det": str(project_root / "det"),
+    "det.yolox": str(project_root / "det" / "yolox"),
+    "det.yolox.utils": str(project_root / "det" / "yolox" / "utils"),
+    "det.yolox.models": str(project_root / "det" / "yolox" / "models"),
+}
+for pkg, pkg_path in _stub_packages.items():
+    if pkg not in sys.modules:
+        mod = types.ModuleType(pkg)
+        mod.__path__ = [pkg_path]
+        mod.__package__ = pkg
+        sys.modules[pkg] = mod
+
+# Now import individual modules directly using importlib
+def _import_module(dotted_path):
+    """Import a single .py module by file path, bypassing __init__.py."""
+    parts = dotted_path.split(".")
+    file_path = project_root / "/".join(parts[:-1]) / (parts[-1] + ".py")
+    spec = importlib.util.spec_from_file_location(dotted_path, file_path,
+        submodule_search_locations=[])
+    mod = importlib.util.module_from_spec(spec)
+    mod.__package__ = ".".join(parts[:-1])
+    sys.modules[dotted_path] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+# Import order matters: dependencies first
+_model_utils = _import_module("det.yolox.utils.model_utils")
+_boxes = _import_module("det.yolox.utils.boxes")
+# Expose bboxes_iou on the utils stub so `from det.yolox.utils import bboxes_iou` works
+sys.modules["det.yolox.utils"].bboxes_iou = _boxes.bboxes_iou
+_network_blocks = _import_module("det.yolox.models.network_blocks")
+_losses = _import_module("det.yolox.models.losses")
+_darknet = _import_module("det.yolox.models.darknet")
+_yolo_pafpn = _import_module("det.yolox.models.yolo_pafpn")
+_yolo_head = _import_module("det.yolox.models.yolo_head")
+_yolox = _import_module("det.yolox.models.yolox")
+
+YOLOX = _yolox.YOLOX
+YOLOPAFPN = _yolo_pafpn.YOLOPAFPN
+YOLOXHead = _yolo_head.YOLOXHead
+SiLU = _network_blocks.SiLU
+replace_module = _model_utils.replace_module
+
+
+def make_parser():
+    parser = argparse.ArgumentParser("YOLOX OpenVINO Export")
+    parser.add_argument(
+        "--ckpt",
+        type=str,
+        required=True,
+        help="Path to checkpoint file (e.g., output/yolox/.../model_final.pth)"
+    )
+    parser.add_argument(
+        "-o", "--output",
+        type=str,
+        default="models/openvino/yolox",
+        help="Output directory for OpenVINO IR files"
+    )
+    parser.add_argument(
+        "--input-size",
+        type=int,
+        nargs=2,
+        default=None,
+        help="Input size (height width). If not specified, use config default"
+    )
+    parser.add_argument(
+        "--batch-size",
+        type=int,
+        default=1,
+        help="Batch size for export (default: 1)"
+    )
+    parser.add_argument(
+        "--dynamic",
+        action="store_true",
+        help="Export with bounded dynamic batch size [1..max_batch] (default: static batch=1)"
+    )
+    parser.add_argument(
+        "--max-batch",
+        type=int,
+        default=16,
+        help="Upper bound of dynamic batch dimension when --dynamic is set (default: 16)"
+    )
+    parser.add_argument(
+        "--fp16",
+        action="store_true",
+        help="Convert model to FP16 precision"
+    )
+    parser.add_argument(
+        "--verify",
+        action="store_true",
+        help="Verify OpenVINO model against PyTorch model"
+    )
+    parser.add_argument(
+        "--convert-mode",
+        type=str,
+        default="pytorch-ov",
+        choices=["pytorch-onnx-ov", "pytorch-ov"],
+        help="Conversion mode: pytorch-onnx-ov (via ONNX) or pytorch-ov (direct)"
+    )
+    # Model architecture args (to bypass LazyConfig dependency chain)
+    parser.add_argument(
+        "--num-classes",
+        type=int,
+        default=None,
+        help="Number of detection classes. Auto-detected from checkpoint if not specified"
+    )
+    parser.add_argument(
+        "--depth",
+        type=float,
+        default=1.33,
+        help="YOLOX backbone depth factor (default: 1.33 for YOLOX-X)"
+    )
+    parser.add_argument(
+        "--width",
+        type=float,
+        default=1.25,
+        help="YOLOX backbone width factor (default: 1.25 for YOLOX-X)"
+    )
+
+    return parser
+
+
+def detect_num_classes(ckpt_path):
+    """Auto-detect number of classes from checkpoint"""
+    ckpt = torch.load(ckpt_path, map_location="cpu", weights_only=True)
+    if "model" in ckpt:
+        ckpt = ckpt["model"]
+
+    # Find the cls_preds conv layer to determine num_classes
+    for key in ckpt:
+        if "head.cls_preds" in key and key.endswith(".weight"):
+            num_classes = ckpt[key].shape[0]
+            return num_classes
+
+    return None
+
+
+def build_yolox_model(depth, width, num_classes):
+    """Build YOLOX model directly (bypass LazyConfig)"""
+    in_channels = [256, 512, 1024]
+    backbone = YOLOPAFPN(depth=depth, width=width, in_channels=in_channels)
+    head = YOLOXHead(num_classes=num_classes, width=width, in_channels=in_channels)
+    model = YOLOX(backbone=backbone, head=head)
+    return model
+
+
+def load_pytorch_model(ckpt_path, depth, width, num_classes):
+    """Load PyTorch YOLOX model from checkpoint"""
+    logger.info(f"Loading PyTorch model from: {ckpt_path}")
+
+    # Build model
+    model = build_yolox_model(depth, width, num_classes)
+    model.eval()
+
+    # Load checkpoint
+    ckpt = torch.load(ckpt_path, map_location="cpu", weights_only=True)
+    if "model" in ckpt:
+        ckpt = ckpt["model"]
+    model.load_state_dict(ckpt)
+
+    # Replace SiLU with standard version for better ONNX/OpenVINO compatibility
+    model = replace_module(model, nn.SiLU, SiLU)
+
+    # Set model to inference mode
+    model.head.decode_in_inference = False
+
+    logger.info("PyTorch model loaded successfully")
+    return model
+
+
+def export_to_onnx(model, dummy_input, onnx_path, dynamic=False):
+    """Export PyTorch model to ONNX"""
+    logger.info(f"Exporting to ONNX: {onnx_path}")
+
+    # Prepare dynamic axes
+    dynamic_axes = None
+    if dynamic:
+        dynamic_axes = {
+            "images": {0: "batch"},
+            "output": {0: "batch"}
+        }
+
+    # Export
+    torch.onnx.export(
+        model,
+        dummy_input,
+        onnx_path,
+        input_names=["images"],
+        output_names=["output"],
+        dynamic_axes=dynamic_axes,
+        opset_version=11,
+        do_constant_folding=True,
+    )
+
+    logger.info(f"ONNX model saved to: {onnx_path}")
+
+    # Simplify ONNX (optional)
+    try:
+        import onnx
+        from onnxsim import simplify
+
+        logger.info("Simplifying ONNX model...")
+        onnx_model = onnx.load(onnx_path)
+        model_simp, check = simplify(onnx_model)
+
+        if check:
+            onnx.save(model_simp, onnx_path)
+            logger.info("ONNX model simplified successfully")
+        else:
+            logger.warning("ONNX simplification failed, using original model")
+    except ImportError:
+        logger.warning("onnxsim not installed, skipping ONNX simplification")
+    except Exception as e:
+        logger.warning(f"ONNX simplification failed: {e}")
+
+
+def _set_yolox_shapes(ov_model, input_size, dynamic=False, max_batch=16):
+    """Set shapes on an OpenVINO YOLOX model.
+
+    By default, enforce fully static shapes (batch=1) for maximum optimization.
+    With dynamic=True, use bounded dynamic batch [1..max_batch].
+    """
+    import openvino as ov
+    h, w = input_size
+    if dynamic:
+        B = ov.Dimension(1, max_batch)
+        logger.info(f"Setting bounded dynamic batch [1..{max_batch}], spatial {h}x{w}")
+    else:
+        B = 1
+        logger.info(f"Setting static shapes: batch=1, spatial {h}x{w}")
+    ov_model.reshape({"images": ov.PartialShape([B, 3, h, w])})
+    # Name output
+    for output in ov_model.outputs:
+        output.tensor.set_names({"output"})
+    return ov_model
+
+
+def export_to_openvino_from_onnx(onnx_path, output_dir, fp16=False,
+                                  input_size=(640, 640), dynamic=False, max_batch=16):
+    """Convert ONNX model to OpenVINO IR"""
+    try:
+        import openvino as ov
+        logger.info(f"Using OpenVINO version: {ov.__version__}")
+    except ImportError:
+        logger.error("OpenVINO not installed. Please install: pip install openvino")
+        return None
+
+    logger.info(f"Converting ONNX to OpenVINO IR...")
+
+    # Create output directory
+    os.makedirs(output_dir, exist_ok=True)
+
+    # Load ONNX model and convert to OpenVINO IR
+    core = ov.Core()
+    model = core.read_model(onnx_path)
+    model = _set_yolox_shapes(model, input_size, dynamic=dynamic, max_batch=max_batch)
+
+    # Save OpenVINO IR
+    output_xml = os.path.join(output_dir, "yolox.xml")
+    output_bin = os.path.join(output_dir, "yolox.bin")
+
+    if fp16:
+        logger.info("Compressing model to FP16...")
+    ov.save_model(model, output_xml, compress_to_fp16=fp16)
+
+    logger.info(f"OpenVINO IR saved:")
+    logger.info(f"  - XML: {output_xml}")
+    logger.info(f"  - BIN: {output_bin}")
+
+    return model
+
+
+def export_to_openvino_direct(pytorch_model, dummy_input, output_dir, fp16=False,
+                               input_size=(640, 640), dynamic=False, max_batch=16):
+    """Convert PyTorch model directly to OpenVINO IR (bypass ONNX)"""
+    try:
+        import openvino as ov
+        logger.info(f"Using OpenVINO version: {ov.__version__}")
+    except ImportError:
+        logger.error("OpenVINO not installed. Please install: pip install openvino")
+        return None
+
+    logger.info(f"Converting PyTorch directly to OpenVINO IR...")
+
+    # Create output directory
+    os.makedirs(output_dir, exist_ok=True)
+
+    logger.info("Using ov.convert_model() for direct conversion...")
+
+    pytorch_model = pytorch_model.cpu()
+    pytorch_model.eval()
+
+    ov_model = ov.convert_model(
+        pytorch_model,
+        example_input=dummy_input.cpu(),
+    )
+    # Name the input so _set_yolox_shapes can find it by name
+    for inp in ov_model.inputs:
+        logger.info(f"  Raw input: name={inp.any_name}, shape={inp.partial_shape}")
+        inp.tensor.set_names({"images"})
+    ov_model = _set_yolox_shapes(ov_model, input_size, dynamic=dynamic, max_batch=max_batch)
+
+    logger.info("Direct PyTorch to OpenVINO conversion successful")
+
+    # Save OpenVINO IR
+    output_xml = os.path.join(output_dir, "yolox.xml")
+    output_bin = os.path.join(output_dir, "yolox.bin")
+
+    if fp16:
+        logger.info("Compressing model to FP16...")
+    ov.save_model(ov_model, output_xml, compress_to_fp16=fp16)
+
+    logger.info(f"OpenVINO IR saved:")
+    logger.info(f"  - XML: {output_xml}")
+    logger.info(f"  - BIN: {output_bin}")
+
+    return ov_model
+
+
+def verify_models(pytorch_model, ov_model, dummy_input):
+    """Verify OpenVINO model output matches PyTorch"""
+    logger.info("Verifying OpenVINO model against PyTorch...")
+
+    try:
+        import openvino as ov
+    except ImportError:
+        logger.error("OpenVINO not installed, skipping verification")
+        return
+
+    # PyTorch inference
+    pytorch_model = pytorch_model.cpu()
+    dummy_input = dummy_input.cpu()
+
+    with torch.no_grad():
+        pytorch_output = pytorch_model(dummy_input)
+
+    # Get output tensor
+    if isinstance(pytorch_output, dict):
+        pytorch_output = pytorch_output.get("det_preds", pytorch_output)
+
+    pytorch_output_np = pytorch_output.cpu().numpy()
+
+    # OpenVINO inference
+    core = ov.Core()
+    compiled_model = core.compile_model(ov_model, "CPU")
+
+    input_tensor = dummy_input.cpu().numpy()
+    ov_output = compiled_model([input_tensor])
+    ov_output_np = ov_output[0]
+
+    # Compare outputs
+    diff = np.abs(pytorch_output_np - ov_output_np)
+    max_diff = np.max(diff)
+    mean_diff = np.mean(diff)
+
+    logger.info(f"Verification results:")
+    logger.info(f"  - Max difference: {max_diff:.6f}")
+    logger.info(f"  - Mean difference: {mean_diff:.6f}")
+    logger.info(f"  - PyTorch output shape: {pytorch_output_np.shape}")
+    logger.info(f"  - OpenVINO output shape: {ov_output_np.shape}")
+
+    # Check if outputs are similar (threshold can be adjusted)
+    if max_diff < 1e-3:
+        logger.info("✅ Verification PASSED: Outputs match closely")
+    elif max_diff < 1e-2:
+        logger.warning("⚠️  Verification WARNING: Small differences detected")
+    else:
+        logger.error("❌ Verification FAILED: Large differences detected")
+
+
+def main():
+    args = make_parser().parse_args()
+
+    # Save log to output directory
+    os.makedirs(args.output, exist_ok=True)
+    log_path = os.path.join(args.output, "export.log")
+    logger.add(log_path, mode="w")
+
+    logger.info("="*60)
+    logger.info("YOLOX to OpenVINO Export")
+    logger.info("="*60)
+    logger.info(f"Checkpoint: {args.ckpt}")
+    logger.info(f"Output: {args.output}")
+    logger.info(f"Conversion mode: {args.convert_mode}")
+
+    # Check if checkpoint exists
+    if not os.path.exists(args.ckpt):
+        logger.error(f"Checkpoint not found: {args.ckpt}")
+        return 1
+
+    # Auto-detect num_classes from checkpoint if not specified
+    num_classes = args.num_classes
+    if num_classes is None:
+        logger.info("Auto-detecting num_classes from checkpoint...")
+        num_classes = detect_num_classes(args.ckpt)
+        if num_classes is None:
+            logger.error("Could not detect num_classes. Please specify --num-classes")
+            return 1
+        logger.info(f"Detected num_classes: {num_classes}")
+
+    # Get input size (default 640x640 for YOLOX)
+    input_size = tuple(args.input_size) if args.input_size else (640, 640)
+
+    logger.info(f"Model: YOLOX (depth={args.depth}, width={args.width}, classes={num_classes})")
+    logger.info(f"Input size: {input_size}")
+    logger.info(f"Batch size: {args.batch_size}")
+    logger.info(f"Dynamic batch: {args.dynamic}")
+
+    # Load PyTorch model
+    model = load_pytorch_model(args.ckpt, args.depth, args.width, num_classes)
+    model = model.to("cpu")
+
+    # Create dummy input
+    dummy_input = torch.randn(
+        args.batch_size, 3, input_size[0], input_size[1],
+        device="cpu"
+    )
+
+    # Test PyTorch model
+    logger.info("Testing PyTorch model...")
+    with torch.no_grad():
+        pytorch_output = model(dummy_input)
+    logger.info(f"PyTorch output shape: {pytorch_output.shape if isinstance(pytorch_output, torch.Tensor) else 'dict'}")
+
+    # Choose conversion path based on mode
+    if args.convert_mode == "pytorch-onnx-ov":
+        logger.info("Using PyTorch → ONNX → OpenVINO conversion path")
+
+        onnx_path = os.path.join(args.output, "yolox.onnx")
+        os.makedirs(args.output, exist_ok=True)
+        export_to_onnx(model, dummy_input, onnx_path, args.dynamic)
+
+        ov_model = export_to_openvino_from_onnx(
+            onnx_path, args.output, args.fp16,
+            input_size=input_size, dynamic=args.dynamic, max_batch=args.max_batch,
+        )
+
+    elif args.convert_mode == "pytorch-ov":
+        logger.info("Using PyTorch → OpenVINO direct conversion path")
+
+        ov_model = export_to_openvino_direct(
+            model, dummy_input, args.output, args.fp16,
+            input_size=input_size, dynamic=args.dynamic, max_batch=args.max_batch,
+        )
+
+    else:
+        logger.error(f"Unknown conversion mode: {args.convert_mode}")
+        return 1
+
+    if ov_model is None:
+        logger.error("OpenVINO export failed")
+        return 1
+
+    # Verify if requested
+    if args.verify:
+        verify_models(model, ov_model, dummy_input)
+
+    logger.info("="*60)
+    logger.info("✅ Export completed successfully!")
+    logger.info("="*60)
+    logger.info(f"OpenVINO IR files saved to: {args.output}")
+    logger.info(f"  - yolox.xml (model structure)")
+    logger.info(f"  - yolox.bin (weights)")
+
+    if args.convert_mode == "pytorch-onnx-ov":
+        logger.info(f"  - yolox.onnx (intermediate format)")
+        logger.info("")
+        logger.info("Note: You can delete yolox.onnx if you only need the OpenVINO IR files")
+    else:
+        logger.info("")
+        logger.info("Note: Direct PyTorch→OpenVINO conversion (no ONNX intermediate file)")
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
