+    p.add_argument("--gdrn-model", required=True, help="Path to GDRN .xml")
+    p.add_argument("--dataset-dir", default="datasets/BOP_DATASETS/lmo",
+                   help="Path to BOP dataset root (e.g. datasets/BOP_DATASETS/lmo)")
+    p.add_argument("--output", default="eval_output/lmo_openvino",
+                   help="Output directory for CSV and evaluation results")
+    p.add_argument("--device", default="GPU", help="OpenVINO device (CPU, GPU, AUTO)")
+    p.add_argument("--num-classes", type=int, default=8)
+    p.add_argument("--conf-thr", type=float, default=0.01)
+    p.add_argument("--nms-thr", type=float, default=0.65)
+    p.add_argument("--use-pnp", action="store_true", default=False,
+                   help="Use PnP RANSAC (default: False)")
+    p.add_argument("--mask-thr", type=float, default=0.5)
+    p.add_argument("--error-types", default="ad,reteS,reS,teS",
+                   help="BOP error types to evaluate (comma-separated)")
+    p.add_argument("--det-file", default=None,
+                   help="Path to pre-computed detection JSON (e.g. test_bboxes/yolox_*.json). "
+                        "When provided, skips YOLOX and uses these bboxes for GDRN input.")
+    p.add_argument("--det-score-thr", type=float, default=0.0,
+                   help="Score threshold for pre-computed detections (default: 0.0)")
+    p.add_argument("--save-only", action="store_true",
+                   help="Only save CSV, skip BOP evaluation")
+    # Depth refinement options
+    p.add_argument("--depth-refine", action="store_true",
+                   help="Enable depth-based translation refinement (requires depth images)")
+    p.add_argument("--refine-iter", type=int, default=2,
+                   help="Number of depth refinement iterations (default: 2)")
+    p.add_argument("--refine-thr", type=float, default=0.8,
+                   help="Confidence threshold for depth refinement (default: 0.8)")
+    p.add_argument("--profile", action="store_true",
+                   help="Enable per-stage timing and save profiling_report.txt at end")
+    return p.parse_args()
+
+
+if __name__ == "__main__":
