+#!/usr/bin/env python3
+"""
+GDRNPP 6D Pose Estimation Pipeline using OpenVINO.
+
+Pipeline:
+  Image -> YOLOX (detection) -> GDRN (pose estimation) -> 6D poses
+
+Two post-processing paths:
+  - PnP RANSAC (default, use_pnp=True): uses predicted coordinate maps + mask
+    to establish 2D-3D correspondences, then cv2.solvePnPRansac for pose.
+  - Direct regression (use_pnp=False): uses rot6d + translation head outputs
+    directly with allocentric->egocentric conversion.
+
+This module is dataset-agnostic: it consumes and returns class indices
+(``class_id`` in [0, num_classes)) and does not know about BOP ``obj_id`` /
+``obj_name``. Callers are responsible for translating between dataset-
+specific ids and GDRN's contiguous class indices.
+
+Runtime dependencies are listed in requirements/requirements_deploy.txt.
+PyTorch, torchvision, mmcv and detectron2 are not required for inference.
+"""
+
+import contextlib
+import time
+
+import cv2
+import numpy as np
+import openvino as ov
+
+from infer_utils import (
+    yolox_preproc,
+    decode_yolox_outputs,
+    yolox_postprocess,
+    crop_resize_by_warp_affine,
+    get_2d_coord_np,
+    rot6d_to_mat_batch,
+    allocentric_to_egocentric,
+    get_out_coor,
+    get_out_mask,
+    get_img_model_points_with_coords2d,
+    get_K_crop_resize,
+    depth_refine_pose,
+    DepthRenderer,
+    pnp_v2,
+)
+
+
+# =============================================================================
+# Profiler
+# =============================================================================
+
+class Profiler:
+    """Lightweight per-section timer with enable/disable toggle.
+
+    Usage:
+        prof = Profiler(enabled=True)
+        with prof.section("yolox_infer"):
+            ...
+        prof.report()
+
+    When disabled, section() is a no-op context manager (zero overhead
+    beyond a dict lookup + contextmanager call).
+    """
+
+    def __init__(self, enabled=False):
+        self.enabled = enabled
+        # section name → dict(total, count, min, max)
+        self.stats = {}
+        self.parents = {}
+        self._stack = []
+
+    @contextlib.contextmanager
+    def section(self, name):
+        if not self.enabled:
+            yield
+            return
+        parent = self._stack[-1] if self._stack else None
+        known_parent = self.parents.get(name, parent)
+        if known_parent != parent:
+            raise ValueError(
+                f"Profiler section {name!r} has multiple parents: "
+                f"{known_parent!r} and {parent!r}"
+            )
+        self.parents[name] = parent
+        self._stack.append(name)
+        t0 = time.perf_counter()
+        try:
+            yield
+        finally:
+            elapsed = time.perf_counter() - t0
+            self._stack.pop()
+            s = self.stats.get(name)
+            if s is None:
+                self.stats[name] = {
+                    "total": elapsed, "count": 1,
+                    "min": elapsed, "max": elapsed,
+                }
+            else:
+                s["total"] += elapsed
+                s["count"] += 1
+                if elapsed < s["min"]:
+                    s["min"] = elapsed
+                if elapsed > s["max"]:
+                    s["max"] = elapsed
+
+    def add(self, name, elapsed):
+        """Manually add an elapsed time sample (for code paths that can't
+        use the context manager, e.g. inside loops with early continues)."""
+        if not self.enabled:
+            return
+        s = self.stats.get(name)
+        if s is None:
+            self.stats[name] = {
+                "total": elapsed, "count": 1,
+                "min": elapsed, "max": elapsed,
+            }
+        else:
+            s["total"] += elapsed
+            s["count"] += 1
+            if elapsed < s["min"]:
+                s["min"] = elapsed
+            if elapsed > s["max"]:
+                s["max"] = elapsed
+
+    def reset(self):
+        self.stats = {}
+        self.parents = {}
+        self._stack = []
+
+    def snapshot(self):
+        """Return a per-section {name: total_seconds} dict (cumulative)."""
+        return {k: v["total"] for k, v in self.stats.items()}
+
+    def diff(self, prev_snapshot):
+        """Return {name: seconds_since(prev_snapshot)} for all current sections."""
+        out = {}
+        for k, v in self.stats.items():
+            out[k] = v["total"] - prev_snapshot.get(k, 0.0)
+        return out
+
+    def report(self, sort_by="total"):
+        """Print and return a per-section timing table."""
+        if not self.enabled or not self.stats:
+            return ""
+        children = {}
+        for name in self.stats:
+            children.setdefault(self.parents.get(name), []).append(name)
+        for names in children.values():
+            if sort_by == "total":
+                names.sort(key=lambda name: self.stats[name]["total"], reverse=True)
+            else:
+                names.sort()
+
+        items = []
+
+        def append_children(parent, depth):
+            for name in children.get(parent, []):
+                items.append((name, self.stats[name], depth))
+                append_children(name, depth + 1)
+
+        append_children(None, 0)
+
+        name_w = max(len(name) + depth * 2 for name, _, depth in items)
+        name_w = max(name_w, 20)
+
+        header = (f"{'section':<{name_w}}  {'count':>7}  {'total(s)':>10}  "
+                  f"{'avg(ms)':>10}  {'min(ms)':>10}  {'max(ms)':>10}")
+        sep = "-" * len(header)
+        lines = [
+            "=" * len(header),
+            "Profiling report",
+            "=" * len(header),
+            header,
+            sep,
+        ]
+        for name, s, depth in items:
+            avg = s["total"] / s["count"] * 1000
+            display_name = f"{'  ' * depth}{name}"
+            lines.append(
+                f"{display_name:<{name_w}}  {s['count']:>7d}  {s['total']:>10.3f}  "
+                f"{avg:>10.2f}  {s['min']*1000:>10.2f}  {s['max']*1000:>10.2f}"
+            )
+        lines.append("=" * len(header))
+        report = "\n".join(lines)
+        print(f"\n{report}")
+        return report
+
+
+# =============================================================================
+# ROI Crop Preparation for GDRN
+# =============================================================================
+
+def prepare_gdrn_inputs(image, detections, ratio, cam_K, extents_per_class,
+                         input_res=256, output_res=64, dzi_pad_scale=1.5,
+                         pixel_mean=(0.0, 0.0, 0.0), pixel_std=(255.0, 255.0, 255.0)):
+    """Prepare batched GDRN inputs from YOLOX detections.
+
+    Args:
+        image: BGR uint8 image (H, W, 3)
+        detections: (M, 7) ndarray from yolox_postprocess
+                    columns: [x1, y1, x2, y2, obj_conf, cls_conf, cls_id]
+        ratio: preprocessing scale factor from yolox_preproc
+        cam_K: (3, 3) camera intrinsic matrix
+        extents_per_class: dict mapping class_index → (3,) float32 extent
+        input_res: GDRN input resolution (256)
+        output_res: GDRN output resolution (64)
+        dzi_pad_scale: bbox padding scale (1.5 for LMO)
+        pixel_mean: per-channel mean for normalization (LMO default: 0)
+        pixel_std: per-channel std for normalization (LMO default: 255, i.e. /255)
+
+    Returns:
+        dict with batched numpy arrays ready for OpenVINO, or None if no detections.
+        Also returns metadata needed for post-processing.
+    """
+    if detections is None or len(detections) == 0:
+        return None, None
+
+    im_H, im_W = image.shape[:2]
+    image_f = image.astype(np.float32)
+
+    batch_images = []
+    batch_classes = []
+    batch_coord_2d = []
+    batch_extents = []
+    meta = {
+        "bbox_centers": [],
+        "scales": [],
+        "roi_whs": [],
+        "resize_ratios": [],
+        "scores": [],
+        "class_ids": [],
+        "roi_coord_2d": [],
+        "extents": [],
+        "cam_K": cam_K,
+        "im_H": im_H,
+        "im_W": im_W,
+    }
+
+    for det in detections:
+        # postprocess output: (x1, y1, x2, y2, obj_conf, cls_conf, cls_id)
+        x1, y1, x2, y2 = det[0:4] / ratio  # scale back to original image space
+        score = float(det[4] * det[5])       # obj_conf * cls_conf
+        cls_id = int(det[6])
+
+        # Bbox center and scale
+        cx, cy = 0.5 * (x1 + x2), 0.5 * (y1 + y2)
+        bw = max(x2 - x1, 1.0)
+        bh = max(y2 - y1, 1.0)
+        scale = max(bw, bh) * dzi_pad_scale
+        scale = min(scale, max(im_H, im_W))
+
+        bbox_center = np.array([cx, cy], dtype=np.float32)
+
+        # Crop ROI image and normalize
+        # Matches: predictor_gdrn.py:normalize_image + data_loader.py
+        # LMO config: PIXEL_MEAN=[0,0,0], PIXEL_STD=[255,255,255] → /255
+        roi_img = crop_resize_by_warp_affine(
+            image_f, bbox_center, scale, input_res
+        )
+        roi_img = roi_img.transpose(2, 0, 1)  # CHW
+        _mean = np.array(pixel_mean, dtype=np.float32).reshape(3, 1, 1)
+        _std = np.array(pixel_std, dtype=np.float32).reshape(3, 1, 1)
+        roi_img = (roi_img - _mean) / _std
+
+        # Crop 2D coord map
+        coord_2d_full = get_2d_coord_np(im_W, im_H, low=0, high=1, fmt="HWC")
+        roi_coord_2d = crop_resize_by_warp_affine(
+            coord_2d_full, bbox_center, scale, output_res
+        )
+        roi_coord_2d = roi_coord_2d.transpose(2, 0, 1)  # (2, out_res, out_res)
+
+        extent = extents_per_class[cls_id]
+
+        batch_images.append(roi_img)
+        batch_classes.append(cls_id)
+        batch_coord_2d.append(roi_coord_2d)
+        batch_extents.append(extent)
+
+        meta["bbox_centers"].append(bbox_center)
+        meta["scales"].append(scale)
+        meta["roi_whs"].append(np.array([bw, bh], dtype=np.float32))
+        meta["resize_ratios"].append(output_res / scale)
+        meta["scores"].append(score)
+        meta["class_ids"].append(cls_id)
+        meta["roi_coord_2d"].append(roi_coord_2d)
+        meta["extents"].append(extent)
+
+    inputs = {
+        "image": np.stack(batch_images).astype(np.float32),
+        "roi_classes": np.array(batch_classes, dtype=np.int64),
+        "roi_coord_2d": np.stack(batch_coord_2d).astype(np.float32),
+        "roi_extents": np.stack(batch_extents).astype(np.float32),
+    }
+    return inputs, meta
+
+
+def prepare_gdrn_inputs_from_bboxes(image, bbox_list, cam_K, extents_per_class,
+                                     input_res=256, output_res=64, dzi_pad_scale=1.5,
+                                     pixel_mean=(0.0, 0.0, 0.0), pixel_std=(255.0, 255.0, 255.0)):
+    """Prepare batched GDRN inputs from pre-computed bounding boxes.
+
+    Matches the original pipeline's data_loader.py preprocessing exactly.
+
+    Args:
+        image: BGR uint8 image (H, W, 3)
+        bbox_list: list of dicts with keys:
+            'bbox_est': [x, y, w, h] in XYWH_ABS format
+            'class_id': 0-based GDRN class index (caller maps dataset ids)
+            'score': detection confidence
+        cam_K: (3, 3) camera intrinsic matrix
+        extents_per_class: dict mapping class_index -> (3,) float32 extent
+        input_res: GDRN input resolution (256)
+        output_res: GDRN output resolution (64)
+        dzi_pad_scale: bbox padding scale (1.5 for LMO)
+        pixel_mean: per-channel mean for normalization
+        pixel_std: per-channel std for normalization
+
+    Returns:
+        dict with batched numpy arrays ready for OpenVINO, or None if no bboxes.
+        Also returns metadata needed for post-processing.
+    """
+    if not bbox_list:
+        return None, None
+
+    im_H, im_W = image.shape[:2]
+    image_f = image.astype(np.float32)
+
+    batch_images = []
+    batch_classes = []
+    batch_coord_2d = []
+    batch_extents = []
+    meta = {
+        "bbox_centers": [],
+        "scales": [],
+        "roi_whs": [],
+        "resize_ratios": [],
+        "scores": [],
+        "class_ids": [],
+        "roi_coord_2d": [],
+        "extents": [],
+        "cam_K": cam_K,
+        "im_H": im_H,
+        "im_W": im_W,
+    }
+
+    for det in bbox_list:
+        cls_id = int(det["class_id"])
+        if cls_id not in extents_per_class:
+            continue
+
+        # XYWH → XYXY
+        bx, by, bw_raw, bh_raw = det["bbox_est"]
+        x1 = bx
+        y1 = by
+        x2 = bx + bw_raw
+        y2 = by + bh_raw
+
+        score = det.get("score", 1.0)
+
+        # Bbox center and scale (matches data_loader.py lines 758-763)
+        cx, cy = 0.5 * (x1 + x2), 0.5 * (y1 + y2)
+        bw = max(x2 - x1, 1.0)
+        bh = max(y2 - y1, 1.0)
+        scale = max(bw, bh) * dzi_pad_scale
+        scale = min(scale, max(im_H, im_W))
+
+        bbox_center = np.array([cx, cy], dtype=np.float32)
+
+        # Crop ROI image and normalize
+        roi_img = crop_resize_by_warp_affine(
+            image_f, bbox_center, scale, input_res
+        )
+        roi_img = roi_img.transpose(2, 0, 1)  # CHW
+        _mean = np.array(pixel_mean, dtype=np.float32).reshape(3, 1, 1)
+        _std = np.array(pixel_std, dtype=np.float32).reshape(3, 1, 1)
+        roi_img = (roi_img - _mean) / _std
+
+        # Crop 2D coord map
+        coord_2d_full = get_2d_coord_np(im_W, im_H, low=0, high=1, fmt="HWC")
+        roi_coord_2d = crop_resize_by_warp_affine(
+            coord_2d_full, bbox_center, scale, output_res
+        )
+        roi_coord_2d = roi_coord_2d.transpose(2, 0, 1)  # (2, out_res, out_res)
+
+        extent = extents_per_class[cls_id]
+
+        batch_images.append(roi_img)
+        batch_classes.append(cls_id)
+        batch_coord_2d.append(roi_coord_2d)
+        batch_extents.append(extent)
+
+        meta["bbox_centers"].append(bbox_center)
+        meta["scales"].append(scale)
+        meta["roi_whs"].append(np.array([bw, bh], dtype=np.float32))
+        meta["resize_ratios"].append(output_res / scale)
+        meta["scores"].append(score)
+        meta["class_ids"].append(cls_id)
+        meta["roi_coord_2d"].append(roi_coord_2d)
+        meta["extents"].append(extent)
+
+    if not batch_images:
+        return None, None
+
+    inputs = {
+        "image": np.stack(batch_images).astype(np.float32),
+        "roi_classes": np.array(batch_classes, dtype=np.int64),
+        "roi_coord_2d": np.stack(batch_coord_2d).astype(np.float32),
+        "roi_extents": np.stack(batch_extents).astype(np.float32),
+    }
+    return inputs, meta
+
+
+# =============================================================================
+# GDRN Post-Processing
+# =============================================================================
+# Translation recovery matches pose_from_pred_centroid_z.py:pose_from_predictions_test
+
+def recover_translation(pred_t, meta):
+    """Recover 3D translation from GDRN predictions.
+
+    Args:
+        pred_t: (N, 3) [centroid_x_rel, centroid_y_rel, z_rel]
+        meta: dict with bbox_centers, roi_whs, resize_ratios, cam_K
+
+    Returns:
+        (N, 3) translations in camera frame [X, Y, Z]
+    """
+    N = pred_t.shape[0]
+    K = meta["cam_K"]
+    fx, fy = K[0, 0], K[1, 1]
+    px, py = K[0, 2], K[1, 2]
+
+    translations = np.empty((N, 3), dtype=np.float32)
+    for i in range(N):
+        cx_rel, cy_rel, z_rel = pred_t[i]
+        roi_wh = meta["roi_whs"][i]
+        roi_center = meta["bbox_centers"][i]
+        resize_ratio = meta["resize_ratios"][i]
+
+        cx = cx_rel * roi_wh[0] + roi_center[0]
+        cy = cy_rel * roi_wh[1] + roi_center[1]
+        z = z_rel * resize_ratio
+
+        translations[i, 0] = z * (cx - px) / fx
+        translations[i, 1] = z * (cy - py) / fy
+        translations[i, 2] = z
+
+    return translations
+
+
+def gdrn_postprocess(pred_rot, pred_t, meta,
+                     coor_x=None, coor_y=None, coor_z=None, vis_mask=None,
+                     depth_refine=False, depth_crops=None, depth_renderer=None,
+                     refine_iter=2, refine_thr=0.8, mask_thr=0.5, output_res=64,
+                     profiler=None):
+    """Full GDRN post-processing: rot6d→R, translation recovery, allo→ego.
+
+    Optionally applies depth-based translation refinement using the direct
+    regression rotation (matches CUDA process_depth_refine path).
+
+    Args:
+        pred_rot: (N, 6) raw 6D rotation predictions
+        pred_t: (N, 3) raw translation predictions
+        meta: dict with roi metadata and camera intrinsics
+        coor_x/y/z, vis_mask: coordinate maps + mask, required if depth_refine=True
+        depth_refine: whether to apply depth refinement
+        depth_crops: list of depth crops (one per instance)
+        depth_renderer: DepthRenderer instance
+
+    Returns:
+        list of pose dicts with 'R', 't', 'score', 'class_id', 'obj_id', 'obj_name'
+    """
+    N = pred_rot.shape[0]
+    prof = profiler if profiler is not None else Profiler(enabled=False)
+
+    # 1. rot6d → rotation matrix
+    with prof.section("post_rot6d"):
+        rot_allo = rot6d_to_mat_batch(pred_rot)  # (N, 3, 3)
+
+    # 2. Recover 3D translation
+    with prof.section("post_recover_t"):
+        translation = recover_translation(pred_t, meta)
+
+    # 3. Allocentric → egocentric
+    with prof.section("post_allo2ego"):
+        ego_rot_preds = np.zeros((N, 3, 3), dtype=np.float32)
+        for i in range(N):
+            allo_pose = np.hstack([rot_allo[i], translation[i].reshape(3, 1)])  # (3, 4)
+            ego_pose = allocentric_to_egocentric(allo_pose, src_type="mat", dst_type="mat")
+            ego_rot_preds[i] = ego_pose[:3, :3]
+
+    # 4. Optional depth refinement on direct-regression poses
+    if depth_refine and depth_crops is not None and depth_renderer is not None:
+        with prof.section("post_depth_refine_prep"):
+            out_xyz = get_out_coor(coor_x, coor_y, coor_z)  # (N, 3, H, W)
+            out_mask = get_out_mask(vis_mask, mask_loss_type="L1")  # (N, 1, H, W)
+        for i in range(N):
+            with prof.section("post_depth_refine"):
+                xyz_i = out_xyz[i].transpose(1, 2, 0)
+                mask_i = out_mask[i, 0]
+                K_crop = get_K_crop_resize(
+                    meta["cam_K"], meta["bbox_centers"][i],
+                    meta["scales"][i], output_res,
+                )
+                translation[i] = depth_refine_pose(
+                    ego_rot_preds[i], translation[i], xyz_i, mask_i,
+                    depth_crops[i], K_crop,
+                    depth_renderer, meta["class_ids"][i],
+                    output_res=output_res,
+                    n_iter=refine_iter, threshold=refine_thr,
+                )
+
+    # 5. Assemble results
+    poses = []
+    for i in range(N):
+        poses.append({
+            "R": ego_rot_preds[i],
+            "t": translation[i],
+            "score": meta["scores"][i],
+            "class_id": meta["class_ids"][i],
+        })
+
+    return poses
+
+
+def gdrn_postprocess_pnp(pred_rot, pred_t, coor_x, coor_y, coor_z, vis_mask,
+                          meta, mask_thr=0.5, profiler=None):
+    """GDRN post-processing with PnP RANSAC (USE_PNP=True path).
+
+    Uses predicted coordinate maps and visibility mask to establish 2D-3D
+    correspondences, then solves PnP with RANSAC for more accurate poses.
+    Falls back to direct regression if PnP fails (< 4 correspondences).
+
+    Mirrors upstream process_pnp_ransac: PnP and depth refinement are
+    mutually exclusive. For direct+DR use gdrn_postprocess(..., depth_refine=True).
+
+    Args:
+        pred_rot: (N, 6) raw 6D rotation predictions
+        pred_t: (N, 3) raw translation predictions
+        coor_x, coor_y, coor_z: each (N, 1, 64, 64) coordinate maps
+        vis_mask: (N, 1, 64, 64) visibility mask
+        meta: dict with roi metadata and camera intrinsics
+        mask_thr: visibility mask threshold (default 0.5)
+
+    Returns:
+        list of pose dicts with 'R', 't', 'score', 'class_id', 'obj_id', 'obj_name'
+    """
+    N = pred_rot.shape[0]
+    cam_K = meta["cam_K"]
+    im_H, im_W = meta["im_H"], meta["im_W"]
+    prof = profiler if profiler is not None else Profiler(enabled=False)
+
+    # Get normalized coordinate maps and masks
+    with prof.section("post_pnp_prep"):
+        out_xyz = get_out_coor(coor_x, coor_y, coor_z)   # (N, 3, H, W)
+        out_mask = get_out_mask(vis_mask, mask_loss_type="L1")  # (N, 1, H, W)
+
+    # Also compute direct regression poses as fallback
+    with prof.section("post_direct_fallback"):
+        direct_poses = gdrn_postprocess(pred_rot, pred_t, meta)
+
+    poses = []
+    for i in range(N):
+        cls_id = meta["class_ids"][i]
+        extent = meta["extents"][i]
+
+        # coord2d for this ROI: (2, out_res, out_res) → (H, W, 2)
+        coord2d_i = meta["roi_coord_2d"][i].transpose(1, 2, 0)  # (H, W, 2)
+
+        # xyz and mask for this instance: (3, H, W) → (H, W, 3), (H, W)
+        xyz_i = out_xyz[i].transpose(1, 2, 0)     # (H, W, 3)
+        mask_i = out_mask[i, 0]                     # (H, W)
+
+        with prof.section("post_pnp_correspondences"):
+            image_points, model_points = get_img_model_points_with_coords2d(
+                mask_i, xyz_i, coord2d_i,
+                im_H=im_H, im_W=im_W, extent=extent, mask_thr=mask_thr,
+            )
+
+        if len(image_points) >= 4:
+            with prof.section("post_pnp_solve"):
+                pose_est = pnp_v2(
+                    model_points, image_points, cam_K,
+                    ransac=True, ransac_reprojErr=3.0, ransac_iter=100,
+                )
+            if pose_est is not None:
+                R_est = pose_est[:3, :3].astype(np.float32)
+                t_est = pose_est[:3, 3].astype(np.float32)
+
+                poses.append({
+                    "R": R_est,
+                    "t": t_est,
+                    "score": meta["scores"][i],
+                    "class_id": cls_id,
+                    "method": "pnp_ransac",
+                })
+                continue
+
+        # Fallback to direct regression
+        fallback = direct_poses[i]
+        fallback["method"] = "direct"
+        poses.append(fallback)
+
+    return poses
+
+
+# =============================================================================
+# Pipeline
+# =============================================================================
+
+class GDRNPPPipeline:
+    """End-to-end GDRNPP 6D pose estimation pipeline using OpenVINO."""
+
+    def __init__(self, yolox_model_path, gdrn_model_path,
+                 extents, cam_K, num_classes, device="GPU",
+                 conf_thr=0.01, nms_thr=0.65,
+                 dzi_pad_scale=1.5, use_pnp=False, mask_thr=0.5,
+                 depth_refine=False, ply_paths=None,
+                 refine_iter=2, refine_thr=0.8,
+                 enable_profiling=False):
+        self.extents = extents
+        self.cam_K = np.asarray(cam_K, dtype=np.float32)
+        if self.cam_K.shape != (3, 3):
+            raise ValueError(f"cam_K must be 3x3, got shape {self.cam_K.shape}")
+        self.num_classes = num_classes
+        self.conf_thr = conf_thr
+        self.nms_thr = nms_thr
+        self.dzi_pad_scale = dzi_pad_scale
+        if use_pnp and depth_refine:
+            raise ValueError(
+                "use_pnp and depth_refine are mutually exclusive "
+                "(matches upstream process() dispatch). "
+                "For PnP alone set depth_refine=False; "
+                "for depth refinement on direct poses set use_pnp=False."
+            )
+        self.use_pnp = use_pnp
+        self.mask_thr = mask_thr
+        self.depth_refine = depth_refine
+        self.refine_iter = refine_iter
+        self.refine_thr = refine_thr
+        self.profiler = Profiler(enabled=enable_profiling)
+
+        # Create DepthRenderer for depth-based refinement
+        self.depth_renderer = None
+        if depth_refine and ply_paths is not None:
+            self.depth_renderer = DepthRenderer(ply_paths, vertex_scale=0.001)
+
+        core = ov.Core()
+
+        if yolox_model_path is not None:
+            print(f"Loading YOLOX model: {yolox_model_path}")
+            self.yolox = core.compile_model(yolox_model_path, device)
+            yolox_input = self.yolox.input(0)
+            _, _, self.yolox_h, self.yolox_w = yolox_input.shape
+            print(f"YOLOX input size: {self.yolox_h}x{self.yolox_w}")
+        else:
+            self.yolox = None
+            self.yolox_h = self.yolox_w = 640
+
+        print(f"Loading GDRN model: {gdrn_model_path}")
+        self.gdrn = core.compile_model(gdrn_model_path, device)
+        print(f"Device: {device}")
+
+        # Determine max bucket from model bound. Model is exported with bounded
+        # dynamic batch; we chunk inputs into these fixed sizes to avoid
+        # iGPU's worst-case kernel config on odd shapes (see bench_gdrn_batch.py).
+        gdrn_in0 = self.gdrn.input(0).partial_shape
+        model_max_batch = gdrn_in0[0].get_max_length()
+        # Prefer the canonical 1/4/8 bucket; cap by model bound.
+        self.gdrn_buckets = [b for b in (1, 4, 8) if b <= model_max_batch]
+        if not self.gdrn_buckets:
+            self.gdrn_buckets = [model_max_batch]
+        print(f"GDRN batch buckets: {self.gdrn_buckets} (model max={model_max_batch})")
+        self.gdrn_max_bucket = self.gdrn_buckets[-1]
+
+        self._warmup_gdrn()
+
+    def _warmup_gdrn(self):
+        """Run one inference per bucket size so per-shape kernels are cached.
+        Cold starts on iGPU can be multi-second; we pay it up front here."""
+        for b in self.gdrn_buckets:
+            dummy = {
+                "image": np.zeros((b, 3, 256, 256), dtype=np.float32),
+                "roi_classes": np.zeros((b,), dtype=np.int64),
+                "roi_coord_2d": np.zeros((b, 2, 64, 64), dtype=np.float32),
+                "roi_extents": np.ones((b, 3), dtype=np.float32),
+            }
+            t0 = time.perf_counter()
+            self.gdrn(dummy)
+            print(f"  GDRN warmup batch={b}: {(time.perf_counter()-t0)*1000:.0f}ms")
+
+    def _pick_bucket(self, n):
+        """Smallest bucket >= n, or the largest bucket if n > max."""
+        for b in self.gdrn_buckets:
+            if b >= n:
+                return b
+        return self.gdrn_max_bucket
+
+    def _gdrn_infer_batched(self, gdrn_inputs):
+        """Run GDRN inference with bucket-based chunking and zero-padding.
+
+        For each chunk of at most `gdrn_max_bucket` inputs, the chunk is padded
+        up to the smallest bucket that fits, so inference always sees one of
+        the warmed-up shapes. Padding rows' outputs are discarded after concat.
+        """
+        N = gdrn_inputs["image"].shape[0]
+        max_b = self.gdrn_max_bucket
+        chunks_out = []
+        kept_per_chunk = []
+        for start in range(0, N, max_b):
+            end = min(start + max_b, N)
+            n = end - start
+            bucket = self._pick_bucket(n)
+            pad = bucket - n
+            chunk = {k: v[start:end] for k, v in gdrn_inputs.items()}
+            if pad > 0:
+                padded = {}
+                for k, v in chunk.items():
+                    zeros = np.zeros((pad,) + v.shape[1:], dtype=v.dtype)
+                    padded[k] = np.concatenate([v, zeros], axis=0)
+                chunk = padded
+            chunk_out = self.gdrn(chunk)
+            chunks_out.append([v.copy() for v in chunk_out.values()])
+            kept_per_chunk.append(n)
+        # Concat, slicing off padding per chunk
+        n_outputs = len(chunks_out[0])
+        ov_values = []
+        for i in range(n_outputs):
+            parts = [chunks_out[c][i][:kept_per_chunk[c]]
+                     for c in range(len(chunks_out))]
+            ov_values.append(np.concatenate(parts, axis=0))
+        return ov_values
+
+    def __call__(self, image, depth_image=None):
+        """Run full pipeline on a single image.
+
+        Args:
+            image: BGR uint8 image (H, W, 3)
+            depth_image: (H, W) float32 depth map in meters (optional, for depth refine)
+
+        Returns:
+            list of pose dicts
+        """
+        prof = self.profiler
+        t0 = time.perf_counter()
+
+        with prof.section("total"):
+            # 1. YOLOX preprocessing
+            with prof.section("yolox_preproc"):
+                input_size = (self.yolox_h, self.yolox_w)
+                yolox_input, ratio = yolox_preproc(image, input_size)
+                yolox_input = yolox_input[np.newaxis]  # add batch dim: (1, 3, H, W)
+
+            # 2. YOLOX inference (OpenVINO)
+            with prof.section("yolox_infer"):
+                yolox_output = self.yolox({"images": yolox_input})
+                raw_output = list(yolox_output.values())[0]
+
+            # 3. Grid decode + 4. NMS
+            with prof.section("yolox_postproc"):
+                decoded = decode_yolox_outputs(raw_output, input_size)
+                detections_list = yolox_postprocess(
+                    decoded, self.num_classes,
+                    conf_thr=self.conf_thr, nms_thr=self.nms_thr,
+                )
+                detections = detections_list[0]
+            t1 = time.perf_counter()
+
+            if detections is None or len(detections) == 0:
+                print(f"No detections (YOLOX: {(t1-t0)*1000:.1f}ms)")
+                return []
+
+            # 5. Prepare GDRN inputs
+            with prof.section("gdrn_prep"):
+                gdrn_inputs, meta = prepare_gdrn_inputs(
+                    image, detections, ratio, self.cam_K, self.extents,
+                    dzi_pad_scale=self.dzi_pad_scale,
+                )
+            t2 = time.perf_counter()
+
+            # 6. GDRN inference — bucketed chunking + padding
+            with prof.section("gdrn_infer"):
+                ov_values = self._gdrn_infer_batched(gdrn_inputs)
+                pred_rot = ov_values[0]   # (N, 6)
+                pred_t = ov_values[1]     # (N, 3)
+            t3 = time.perf_counter()
+
+            # Prepare depth crops if depth refinement is enabled
+            depth_crops = None
+            if self.depth_refine and depth_image is not None:
+                with prof.section("depth_crop"):
+                    depth_crops = self._prepare_depth_crops(depth_image, meta)
+
+            # 7. Post-process to 6D poses
+            with prof.section("postprocess"):
+                if self.use_pnp and len(ov_values) >= 6:
+                    coor_x = ov_values[2]   # (N, 1, 64, 64)
+                    coor_y = ov_values[3]   # (N, 1, 64, 64)
+                    coor_z = ov_values[4]   # (N, 1, 64, 64)
+                    vis_mask = ov_values[5] # (N, 1, 64, 64)
+                    poses = gdrn_postprocess_pnp(
+                        pred_rot, pred_t, coor_x, coor_y, coor_z, vis_mask,
+                        meta, mask_thr=self.mask_thr,
+                        profiler=prof,
+                    )
+                else:
+                    coor_x = ov_values[2] if len(ov_values) >= 6 else None
+                    coor_y = ov_values[3] if len(ov_values) >= 6 else None
+                    coor_z = ov_values[4] if len(ov_values) >= 6 else None
+                    vis_mask = ov_values[5] if len(ov_values) >= 6 else None
+                    poses = gdrn_postprocess(
+                        pred_rot, pred_t, meta,
+                        coor_x=coor_x, coor_y=coor_y, coor_z=coor_z, vis_mask=vis_mask,
+                        depth_refine=self.depth_refine,
+                        depth_crops=depth_crops,
+                        depth_renderer=self.depth_renderer,
+                        refine_iter=self.refine_iter,
+                        refine_thr=self.refine_thr,
+                        mask_thr=self.mask_thr,
+                        profiler=prof,
+                    )
+            t4 = time.perf_counter()
+
+        print(f"Detected {len(detections)} objects | "
+              f"YOLOX: {(t1-t0)*1000:.1f}ms, "
+              f"Crop: {(t2-t1)*1000:.1f}ms, "
+              f"GDRN: {(t3-t2)*1000:.1f}ms, "
+              f"Post: {(t4-t3)*1000:.1f}ms, "
+              f"Total: {(t4-t0)*1000:.1f}ms")
+
+        return poses
+
+    def run_from_bboxes(self, image, bbox_list, depth_image=None):
+        """Run GDRN pose estimation using pre-computed bounding boxes.
+
+        Skips YOLOX entirely. Used for fair comparison with original pipeline
+        which uses pre-computed detections.
+
+        Args:
+            image: BGR uint8 image (H, W, 3)
+            bbox_list: list of dicts with 'bbox_est', 'obj_id', 'score'
+            depth_image: (H, W) float32 depth map in meters (optional, for depth refine)
+
+        Returns:
+            list of pose dicts
+        """
+        prof = self.profiler
+        t0 = time.perf_counter()
+
+        with prof.section("total"):
+            with prof.section("gdrn_prep"):
+                gdrn_inputs, meta = prepare_gdrn_inputs_from_bboxes(
+                    image, bbox_list, self.cam_K, self.extents,
+                    dzi_pad_scale=self.dzi_pad_scale,
+                )
+
+            if gdrn_inputs is None:
+                return []
+
+            t1 = time.perf_counter()
+
+            # GDRN inference — bucketed chunking + padding
+            with prof.section("gdrn_infer"):
+                ov_values = self._gdrn_infer_batched(gdrn_inputs)
+                pred_rot = ov_values[0]
+                pred_t = ov_values[1]
+            t2 = time.perf_counter()
+
+            # Prepare depth crops if depth refinement is enabled
+            depth_crops = None
+            if self.depth_refine and depth_image is not None:
+                with prof.section("depth_crop"):
+                    depth_crops = self._prepare_depth_crops(depth_image, meta)
+
+            # Post-process
+            with prof.section("postprocess"):
+                if self.use_pnp and len(ov_values) >= 6:
+                    coor_x = ov_values[2]
+                    coor_y = ov_values[3]
+                    coor_z = ov_values[4]
+                    vis_mask = ov_values[5]
+                    poses = gdrn_postprocess_pnp(
+                        pred_rot, pred_t, coor_x, coor_y, coor_z, vis_mask,
+                        meta, mask_thr=self.mask_thr,
+                        profiler=prof,
+                    )
+                else:
+                    coor_x = ov_values[2] if len(ov_values) >= 6 else None
+                    coor_y = ov_values[3] if len(ov_values) >= 6 else None
+                    coor_z = ov_values[4] if len(ov_values) >= 6 else None
+                    vis_mask = ov_values[5] if len(ov_values) >= 6 else None
+                    poses = gdrn_postprocess(
+                        pred_rot, pred_t, meta,
+                        coor_x=coor_x, coor_y=coor_y, coor_z=coor_z, vis_mask=vis_mask,
+                        depth_refine=self.depth_refine,
+                        depth_crops=depth_crops,
+                        depth_renderer=self.depth_renderer,
+                        refine_iter=self.refine_iter,
+                        refine_thr=self.refine_thr,
+                        mask_thr=self.mask_thr,
+                        profiler=prof,
+                    )
+            t3 = time.perf_counter()
+
+        return poses
+
+    def _prepare_depth_crops(self, depth_image, meta, output_res=64):
+        """Crop and resize depth image for each ROI instance.
+
+        Args:
+            depth_image: (H, W) float32 depth map in meters
+            meta: dict with bbox_centers, scales
+            output_res: crop output resolution (default 64)
+
+        Returns:
+            list of (output_res, output_res) float32 depth crops
+        """
+        N = len(meta["bbox_centers"])
+        crops = []
+        for i in range(N):
+            crop = crop_resize_by_warp_affine(
+                depth_image, meta["bbox_centers"][i], meta["scales"][i],
+                output_res, interpolation=cv2.INTER_NEAREST,
+            )
+            if crop.ndim == 3:
+                crop = crop[:, :, 0]
+            crops.append(crop.astype(np.float32))
+        return crops
