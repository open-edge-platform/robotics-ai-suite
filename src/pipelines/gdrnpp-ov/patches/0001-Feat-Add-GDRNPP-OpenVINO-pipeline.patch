diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..0803275
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,58 @@
+services:
+  gdrnpp:
+    build:
+      context: .
+      dockerfile: Dockerfile
+      args:
+        - http_proxy=${http_proxy}
+        - https_proxy=${https_proxy}
+        - no_proxy=${no_proxy}
+        - HOST_UID=${HOST_UID:-1000}
+        - HOST_GID=${HOST_GID:-1000}
+        - HOST_USER=${HOST_USER:-devuser}
+    image: gdrnpp:openvino-gpu
+    container_name: gdrnpp_dev
+
+    # Runtime environment: inherit proxy from host shell
+    environment:
+      - http_proxy=${http_proxy}
+      - https_proxy=${https_proxy}
+      - no_proxy=${no_proxy}
+      - HTTP_PROXY=${http_proxy}
+      - HTTPS_PROXY=${https_proxy}
+      - NO_PROXY=${no_proxy}
+
+    # Intel GPU passthrough (iGPU/dGPU via /dev/dri)
+    devices:
+      - /dev/dri:/dev/dri
+
+    # Join host's render/video groups so the container user can access /dev/dri/*
+    group_add:
+      - "${RENDER_GID:-109}"
+      - "${VIDEO_GID:-44}"
+
+    # Mount volumes
+    volumes:
+      # Mount code for development
+      - .:/workspace/gdrnpp
+      # Mount X11 socket for GUI applications (optional)
+      - /tmp/.X11-unix:/tmp/.X11-unix:rw
+
+    # Network settings
+    network_mode: host
+
+    # IPC mode for shared memory (important for PyTorch DataLoader)
+    ipc: host
+
+    # Run as current host user to avoid permission issues
+    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
+
+    # Keep container running
+    stdin_open: true
+    tty: true
+
+    # Set working directory
+    working_dir: /workspace/gdrnpp
+
+    # Default command
+    command: /bin/bash
diff --git a/docker_build_run.sh b/docker_build_run.sh
new file mode 100755
index 0000000..8eda5ee
--- /dev/null
+++ b/docker_build_run.sh
@@ -0,0 +1,153 @@
+#!/bin/bash
+# Build and run GDRNPP Docker container
+
+set -e
+
+echo "======================================"
+echo "GDRNPP Docker Build and Run Script"
+echo "======================================"
+
+# Colors for output
+RED='\033[0;31m'
+GREEN='\033[0;32m'
+YELLOW='\033[1;33m'
+NC='\033[0m' # No Color
+
+# Function to print colored messages
+print_info() {
+    echo -e "${GREEN}[INFO]${NC} $1"
+}
+
+print_warn() {
+    echo -e "${YELLOW}[WARN]${NC} $1"
+}
+
+print_error() {
+    echo -e "${RED}[ERROR]${NC} $1"
+}
+
+# Check if Docker is installed
+if ! command -v docker &> /dev/null; then
+    print_error "Docker is not installed. Please install Docker first."
+    exit 1
+fi
+
+if ! docker info &> /dev/null; then
+    print_error "Cannot access the Docker daemon."
+    print_error "Add $(whoami) to the docker group, then start a new login session:"
+    echo "    sudo usermod -aG docker $(whoami)"
+    exit 1
+fi
+
+# Check if docker-compose is installed
+if ! command -v docker-compose &> /dev/null; then
+    print_warn "docker-compose is not installed. Using 'docker compose' instead."
+    DOCKER_COMPOSE="docker compose"
+else
+    DOCKER_COMPOSE="docker-compose"
+fi
+
+print_info "All prerequisites are satisfied."
+print_info "PyTorch uses CPU; OpenVINO uses the passed-through Intel GPU."
+
+# Parse command line arguments
+BUILD_ONLY=false
+RUN_ONLY=false
+
+while [[ $# -gt 0 ]]; do
+    case $1 in
+        --build-only)
+            BUILD_ONLY=true
+            shift
+            ;;
+        --run-only)
+            RUN_ONLY=true
+            shift
+            ;;
+        --help)
+            echo "Usage: $0 [OPTIONS]"
+            echo ""
+            echo "Options:"
+            echo "  --build-only    Only build the Docker image"
+            echo "  --run-only      Only run the container (skip build)"
+            echo "  --help          Show this help message"
+            exit 0
+            ;;
+        *)
+            print_error "Unknown option: $1"
+            echo "Use --help for usage information"
+            exit 1
+            ;;
+    esac
+done
+
+# Generate .env with current user's UID/GID so the container
+# runs as the same user as the host (avoids permission issues).
+# Also capture host's render/video GIDs so the container user can access /dev/dri/*.
+RENDER_GID=$(getent group render | cut -d: -f3)
+VIDEO_GID=$(getent group video | cut -d: -f3)
+RENDER_GID=${RENDER_GID:-109}
+VIDEO_GID=${VIDEO_GID:-44}
+HOST_UID=$(id -u)
+HOST_USER=$(getent passwd "${HOST_UID}" | cut -d: -f1)
+HOST_GID=$(getent passwd "${HOST_UID}" | cut -d: -f4)
+
+print_info "Generating .env for current user: ${HOST_USER} (uid=${HOST_UID}, gid=${HOST_GID})"
+print_info "GPU access: render gid=${RENDER_GID}, video gid=${VIDEO_GID}"
+cat > .env <<EOF
+HOST_UID=${HOST_UID}
+HOST_GID=${HOST_GID}
+HOST_USER=${HOST_USER}
+RENDER_GID=${RENDER_GID}
+VIDEO_GID=${VIDEO_GID}
+EOF
+
+# Build Docker image
+if [ "$RUN_ONLY" = false ]; then
+    print_info "Building Docker image..."
+    if $DOCKER_COMPOSE build; then
+        print_info "Docker image built successfully!"
+    else
+        print_error "Docker build failed!"
+        exit 1
+    fi
+fi
+
+if [ "$BUILD_ONLY" = true ]; then
+    print_info "Build complete. Exiting (--build-only flag set)."
+    exit 0
+fi
+
+# Create necessary directories if they don't exist
+print_info "Creating necessary directories..."
+mkdir -p datasets output pretrained_models
+
+# Run Docker container
+print_info "Starting Docker container..."
+if $DOCKER_COMPOSE up -d; then
+    print_info "Container started successfully!"
+    print_info "Building Intel EGL renderer extension..."
