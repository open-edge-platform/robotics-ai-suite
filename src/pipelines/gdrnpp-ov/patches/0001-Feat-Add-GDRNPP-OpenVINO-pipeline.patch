@@ -0,0 +1,713 @@
+#!/usr/bin/env python3
+"""
+Export GDRN pose estimation model from PyTorch to OpenVINO IR format.
+
+The model is exported as a single end-to-end network:
+  image + roi_classes + roi_coord_2d + roi_extents
+    → pred_rot + pred_t + coor_x + coor_y + coor_z + vis_mask
+
+Post-processing (rot6d→R, centroid_z→translation, allo→ego) is NOT included
+in the exported model and should be done on the host. The coor_x/y/z and
+vis_mask outputs enable PnP RANSAC pose refinement (USE_PNP=True path).
+
+Usage:
+    python tools/openvino/export_gdrn_openvino.py \
+        --ckpt output/gdrn/.../model_final_wo_optim.pth \
+        --output models/openvino/gdrn_lmo \
+        --convert-mode pytorch-ov \
+        --verify
+"""
+
+import argparse
+import importlib
+import importlib.util
+import os
+import sys
+import types
+from pathlib import Path
+
+from loguru import logger
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+import numpy as np
+
+# ── project root on sys.path ────────────────────────────────────────────
+project_root = Path(__file__).resolve().parent.parent.parent
+sys.path.insert(0, str(project_root))
+
+# =============================================================================
+# Dependency Isolation Layer
+# =============================================================================
+# GDRNPP's source code has deep dependency chains through its __init__.py files:
+#
+#   from core.gdrn_modeling.models.GDRN import ...
+#     → core/__init__.py → detectron2, mmcv.runner, ...
+#     → core/gdrn_modeling/__init__.py → more heavy deps
+#     → core/gdrn_modeling/models/__init__.py → ...
+#
+# Many of these dependencies (detectron2, mmcv v1 full, CUDA extensions) are
+# either unavailable in our CPU-only Docker environment, or incompatible with
+# Python 3.10 / mmcv v2. However, the actual model files we need (backbone,
+# geo_head, pnp_net) only depend on standard PyTorch, timm, and a few small
+# utility modules.
+#
+# Our strategy has two parts:
+#
+# 1) STUB PACKAGES: Register lightweight placeholder modules for each package
+#    in the import chain. This prevents Python from executing their __init__.py
+#    files (which would trigger the problematic imports). We set __path__ to the
+#    real directory so that sub-module imports (e.g. `from .conv_pnp_net import`)
+#    can still locate the actual .py files on disk.
+#
+# 2) SELECTIVE IMPORTS: Use _imp() to import only the specific .py files we
+#    need (e.g. top_down_doublemask_xyz_region_head.py, conv_pnp_net.py),
+#    bypassing the package __init__.py entirely.
+#
+# This allows us to use the original source files unmodified while avoiding
+# the full dependency tree.
+# =============================================================================
+
+# ── Part 1: Stub packages ───────────────────────────────────────────────
+# Each entry maps a dotted package name to its directory (relative to project root).
+# We create a minimal module with __path__ pointing to the real directory,
+# so Python can resolve sub-imports without executing __init__.py.
+_stub_pkgs = {
+    "det": "det",
+    "det.yolox": "det/yolox",
+    "det.yolox.utils": "det/yolox/utils",
+    "core": "core",
+    "core.gdrn_modeling": "core/gdrn_modeling",
+    "core.gdrn_modeling.models": "core/gdrn_modeling/models",
+    "core.gdrn_modeling.models.heads": "core/gdrn_modeling/models/heads",
+    "core.gdrn_modeling.models.backbones": "core/gdrn_modeling/models/backbones",
+    "core.gdrn_modeling.losses": "core/gdrn_modeling/losses",
+    "core.utils": "core/utils",
+    "lib": "lib",
+    "lib.torch_utils": "lib/torch_utils",
+    "lib.torch_utils.layers": "lib/torch_utils/layers",
+    "lib.utils": "lib/utils",
+    "lib.pysixd": "lib/pysixd",
+}
+for pkg, rel in _stub_pkgs.items():
+    if pkg not in sys.modules:
+        m = types.ModuleType(pkg)
+        m.__path__ = [str(project_root / rel)]
+        m.__package__ = pkg
+        sys.modules[pkg] = m
+# NOTE: lib.torch_utils.layers.dropblock is a real package with a working
+# __init__.py — we intentionally do NOT stub it. The parent stubs above
+# have correct __path__, so Python will find dropblock's __init__.py naturally.
+
+
+def _imp(dotted):
+    """Part 2: Import a single .py file by dotted path, skipping __init__.py.
+
+    For example, _imp("core.gdrn_modeling.models.heads.conv_pnp_net") loads
+    the file core/gdrn_modeling/models/heads/conv_pnp_net.py directly,
+    without triggering any __init__.py in the package chain.
+    """
+    parts = dotted.split(".")
+    fpath = project_root / "/".join(parts[:-1]) / (parts[-1] + ".py")
+    spec = importlib.util.spec_from_file_location(dotted, fpath, submodule_search_locations=[])
+    mod = importlib.util.module_from_spec(spec)
+    mod.__package__ = ".".join(parts[:-1])
+    sys.modules[dotted] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+# =============================================================================
+# mmcv v1 → v2 Compatibility Shims
+# =============================================================================
+# The GDRNPP source code was written for mmcv v1.x (mmcv-full), which provided
+# functions like normal_init, constant_init, kaiming_init, and a CONV_LAYERS
+# registry. In mmcv v2, these were either moved to mmengine or removed entirely.
+#
+# Since we only need these functions during model construction (weight init),
+# and we immediately overwrite all weights from the checkpoint anyway, we can
+# safely provide simple reimplementations. This avoids having to install the
+# deprecated mmcv-full (which requires CUDA to compile).
+# =============================================================================
+import mmcv.cnn as _mmcv_cnn
+import mmcv.cnn.utils as _mmcv_cnn_utils
+
+def _normal_init(module, mean=0, std=1, bias=0):
+    if hasattr(module, "weight") and module.weight is not None:
+        nn.init.normal_(module.weight, mean, std)
+    if hasattr(module, "bias") and module.bias is not None:
+        nn.init.constant_(module.bias, bias)
+
+def _constant_init(module, val, bias=0):
+    if hasattr(module, "weight") and module.weight is not None:
+        nn.init.constant_(module.weight, val)
+    if hasattr(module, "bias") and module.bias is not None:
+        nn.init.constant_(module.bias, bias)
+
+def _kaiming_init(module, a=0, mode="fan_out", nonlinearity="relu", bias=0, distribution="normal"):
+    if hasattr(module, "weight") and module.weight is not None:
+        if distribution == "uniform":
+            nn.init.kaiming_uniform_(module.weight, a=a, mode=mode, nonlinearity=nonlinearity)
+        else:
+            nn.init.kaiming_normal_(module.weight, a=a, mode=mode, nonlinearity=nonlinearity)
+    if hasattr(module, "bias") and module.bias is not None:
+        nn.init.constant_(module.bias, bias)
+
+# Inject shims into mmcv.cnn and mmcv.cnn.utils if the functions are missing
+for _name, _fn in [("normal_init", _normal_init), ("constant_init", _constant_init), ("kaiming_init", _kaiming_init)]:
+    if not hasattr(_mmcv_cnn, _name):
+        setattr(_mmcv_cnn, _name, _fn)
+    if not hasattr(_mmcv_cnn_utils, _name):
+        setattr(_mmcv_cnn_utils, _name, _fn)
+
+# CONV_LAYERS was a Registry in mmcv v1 used by lib/torch_utils/layers/conv_module.py.
+# In mmcv v2 it no longer exists, so we recreate a minimal version.
+try:
+    from mmcv.cnn.bricks.conv import CONV_LAYERS  # noqa: F401
+except ImportError:
+    from mmengine import Registry
+    CONV_LAYERS = Registry("conv_layer")
+    CONV_LAYERS.register_module("Conv1d", module=nn.Conv1d)
+    CONV_LAYERS.register_module("Conv2d", module=nn.Conv2d)
+    CONV_LAYERS.register_module("Conv3d", module=nn.Conv3d)
+    import mmcv.cnn.bricks.conv as _mmcv_conv
+    _mmcv_conv.CONV_LAYERS = CONV_LAYERS
+
+# timm provides the ConvNeXt backbone used by GDRN
+import timm  # noqa: E402
+
+
+# ── Exportable GDRN wrapper ─────────────────────────────────────────────
+class GDRNExportWrapper(nn.Module):
+    """Thin wrapper around GDRN sub-modules for ONNX/OpenVINO export.
+
+    Inputs:
+        image        : (B, 3, 256, 256)   - cropped ROI image
+        roi_classes  : (B,)               - object class index (int64)
+        roi_coord_2d : (B, 2, 64, 64)    - 2D pixel coordinates grid
+        roi_extents  : (B, 3)            - 3D extents of the object
+
+    Outputs:
+        pred_rot     : (B, 6)   - raw 6D rotation (allocentric)
+        pred_t       : (B, 3)   - raw translation (centroid_x_rel, centroid_y_rel, z_rel)
+        coor_x       : (B, 1, 64, 64)  - predicted x coordinate map (for PnP RANSAC)
+        coor_y       : (B, 1, 64, 64)  - predicted y coordinate map (for PnP RANSAC)
+        coor_z       : (B, 1, 64, 64)  - predicted z coordinate map (for PnP RANSAC)
+        vis_mask     : (B, 1, 64, 64)  - predicted visibility mask  (for PnP RANSAC)
+    """
+
+    def __init__(self, backbone, geo_head, pnp_net, num_classes, xyz_out_dim,
+                 mask_out_dim, region_out_dim, out_res=64,
+                 xyz_class_aware=True, mask_class_aware=True, region_class_aware=True,
+                 with_2d_coord=True, mask_loss_type="L1"):
+        super().__init__()
+        self.backbone = backbone
+        self.geo_head = geo_head
+        self.pnp_net = pnp_net
+        self.num_classes = num_classes
+        self.xyz_out_dim = xyz_out_dim
+        self.mask_out_dim = mask_out_dim
+        self.region_out_dim = region_out_dim
+        self.out_res = out_res
+        self.xyz_class_aware = xyz_class_aware
+        self.mask_class_aware = mask_class_aware
+        self.region_class_aware = region_class_aware
+        self.with_2d_coord = with_2d_coord
+        self.mask_loss_type = mask_loss_type
+
+    def forward(self, image, roi_classes, roi_coord_2d, roi_extents):
+        bs = image.shape[0]
+        device = image.device
+
+        # 1) backbone
+        conv_feat = self.backbone(image)  # [B, 1024, 8, 8]
+
+        # 2) geometry head
+        vis_mask, full_mask, coor_x, coor_y, coor_z, region = self.geo_head(conv_feat)
+
+        # 3) class-aware selection via gather
+        idx = roi_classes  # (B,)
+        if self.xyz_class_aware:
+            per_cls = self.xyz_out_dim // 3
+            coor_x = coor_x.view(bs, self.num_classes, per_cls, self.out_res, self.out_res)
+            coor_x = coor_x[torch.arange(bs, device=device), idx]
+            coor_y = coor_y.view(bs, self.num_classes, per_cls, self.out_res, self.out_res)
+            coor_y = coor_y[torch.arange(bs, device=device), idx]
+            coor_z = coor_z.view(bs, self.num_classes, per_cls, self.out_res, self.out_res)
+            coor_z = coor_z[torch.arange(bs, device=device), idx]
+
+        if self.mask_class_aware:
+            half = self.mask_out_dim // 2
+            vis_mask = vis_mask.view(bs, self.num_classes, half, self.out_res, self.out_res)
+            vis_mask = vis_mask[torch.arange(bs, device=device), idx]
+
+        if self.region_class_aware:
+            region = region.view(bs, self.num_classes, self.region_out_dim, self.out_res, self.out_res)
+            region = region[torch.arange(bs, device=device), idx]
+
+        # 4) build PnP input features
+        if coor_x.shape[1] > 1:
+            coor_feat = torch.cat([
+                F.softmax(coor_x[:, :-1], dim=1),
+                F.softmax(coor_y[:, :-1], dim=1),
+                F.softmax(coor_z[:, :-1], dim=1),
+            ], dim=1)
+        else:
+            coor_feat = torch.cat([coor_x, coor_y, coor_z], dim=1)
+
+        if self.with_2d_coord:
+            coor_feat = torch.cat([coor_feat, roi_coord_2d], dim=1)
+
+        # region attention
+        region_softmax = F.softmax(region[:, 1:, :, :], dim=1)
+
+        # mask attention (none for LMO config)
+        mask_atten = None
+
+        # 5) PnP head
+        pred_rot, pred_t = self.pnp_net(
+            coor_feat, region=region_softmax, extents=roi_extents, mask_attention=mask_atten
+        )
+
+        # Also return intermediate geo outputs for PnP RANSAC post-processing.
+        # For L1 loss type (LMO default): coor_x/y/z are (B, 1, 64, 64),
+        # vis_mask is (B, 1, 64, 64).
+        return pred_rot, pred_t, coor_x, coor_y, coor_z, vis_mask
+
+
+# ── Model building ──────────────────────────────────────────────────────
+def build_gdrn_from_checkpoint(ckpt_path):
+    """Build GDRN sub-modules and load weights from checkpoint.
+
+    Returns (wrapper_model, metadata_dict).
+    """
+    logger.info(f"Loading checkpoint: {ckpt_path}")
+    ckpt = torch.load(ckpt_path, map_location="cpu", weights_only=True)
+    state = ckpt["model"] if "model" in ckpt else ckpt
+
+    # ── detect architecture from weights ──
+    meta = _detect_architecture(state)
+    logger.info(f"Detected architecture: {meta}")
+
+    # ── build backbone ──
+    backbone = timm.create_model(
+        meta["backbone_name"],
+        pretrained=False,
+        in_chans=3,
+        features_only=True,
+        out_indices=(3,),
+    )
+
+    # ── build geo head ──
+    _head_mod = _imp("core.gdrn_modeling.models.heads.top_down_doublemask_xyz_region_head")
+    HeadCls = _head_mod.TopDownDoubleMaskXyzRegionHead
+    geo_head = HeadCls(
+        in_dim=meta["backbone_out_dim"],
+        xyz_num_classes=meta["num_classes"] if meta["xyz_class_aware"] else 1,
+        mask_num_classes=meta["num_classes"] if meta["mask_class_aware"] else 1,
+        region_num_classes=meta["num_classes"] if meta["region_class_aware"] else 1,
+        xyz_out_dim=meta["xyz_out_dim"],
+        mask_out_dim=meta["mask_out_dim"],
+        region_out_dim=meta["region_out_dim"],
+    )
+
+    # ── build pnp net ──
+    _pnp_mod = _imp("core.gdrn_modeling.models.heads.conv_pnp_net")
+    PnPCls = _pnp_mod.ConvPnPNet
+    pnp_net = PnPCls(
+        nIn=meta["pnp_in_channel"],
+        num_regions=meta["num_regions"],
+        rot_dim=meta["rot_dim"],
+        norm="GN",
+        act="gelu",
+        mask_attention_type="none",
+    )
+
+    # ── load weights ──
+    _load_submodule(backbone, state, "backbone.")
+    _load_submodule(geo_head, state, "geo_head_net.")
+    _load_submodule(pnp_net, state, "pnp_net.")
+
+    # ── wrap ──
+    model = GDRNExportWrapper(
+        backbone=backbone,
+        geo_head=geo_head,
+        pnp_net=pnp_net,
+        num_classes=meta["num_classes"],
+        xyz_out_dim=meta["xyz_out_dim"],  # total for x+y+z (e.g. 3 for L1)
+        mask_out_dim=meta["mask_out_dim"],
+        region_out_dim=meta["region_out_dim"],
+        out_res=64,
+        xyz_class_aware=meta["xyz_class_aware"],
+        mask_class_aware=meta["mask_class_aware"],
+        region_class_aware=meta["region_class_aware"],
+        with_2d_coord=True,
+        mask_loss_type="L1",
+    )
+    model.eval()
+    return model, meta
+
+
+def _detect_architecture(state):
+    """Infer model architecture from checkpoint keys and weight shapes."""
+    meta = {}
+
+    # Detect backbone type from weight names
+    backbone_keys = [k for k in state if k.startswith("backbone.")]
+    if any("stages" in k for k in backbone_keys):
+        # ConvNeXt uses 'stages' naming
+        meta["backbone_type"] = "convnext"
+        # Detect variant from stem conv shape
+        stem_w = state.get("backbone.stem.0.weight")
+        if stem_w is not None:
+            out_ch = stem_w.shape[0]
+            variant_map = {96: "convnext_tiny", 128: "convnext_base", 192: "convnext_large"}
+            meta["backbone_name"] = variant_map.get(out_ch, "convnext_base")
+        else:
+            meta["backbone_name"] = "convnext_base"
+    else:
+        meta["backbone_name"] = "convnext_base"  # fallback
+
+    # Detect backbone output dim from geo head's first layer
+    # The first layer is ConvTranspose2d: weight shape = [in_channels, out_channels, kH, kW]
+    geo_keys = [k for k in state if k.startswith("geo_head_net.")]
+    feat0_key = "geo_head_net.features.0.weight"
+    if feat0_key in state:
+        # ConvTranspose2d: shape[0] = in_channels = backbone output dim
+        meta["backbone_out_dim"] = state[feat0_key].shape[0]
+    else:
+        meta["backbone_out_dim"] = 1024
+
+    # Detect dimensions from shared out_layer or separate output heads
+    # For TopDownDoubleMaskXyzRegionHead with shared out_layer:
+    #   total = mask_nc*mask_dim + xyz_nc*xyz_dim + region_nc*region_dim
+    # where mask_dim includes vis+full, xyz_dim is total (x+y+z)
+    num_regions = 64
+    region_per_class = num_regions + 1  # 65
+
+    out_layer_key = "geo_head_net.out_layer.weight"
+    if out_layer_key in state:
+        total_out = state[out_layer_key].shape[0]
+        # Infer num_classes: try each candidate
+        # total = nc*(mask_dim + xyz_dim + region_dim)
+        # For L1 loss: mask_dim=2 (vis+full), xyz_dim=3 (x+y+z each 1ch), region_dim=65
+        # Per-class total = 2 + 3 + 65 = 70
+        per_class_total = 2 + 3 + region_per_class  # 70
+        if total_out % per_class_total == 0:
+            num_classes = total_out // per_class_total
+        else:
+            num_classes = 8
+        xyz_out_dim = 3   # total for x+y+z (L1: 1 channel each)
+        mask_out_dim = 2  # vis + full (L1: 1 channel each)
+    else:
+        num_classes = 8
+        xyz_out_dim = 3
+        mask_out_dim = 2
+
+    meta["num_classes"] = num_classes
+    meta["num_regions"] = num_regions
+    meta["xyz_out_dim"] = xyz_out_dim    # total for all 3 coords
+    meta["mask_out_dim"] = mask_out_dim  # total for vis + full
+    meta["region_out_dim"] = region_per_class
+    meta["xyz_class_aware"] = True   # always true for class-aware configs
+    meta["mask_class_aware"] = True
+    meta["region_class_aware"] = True
+
+    # PnP net input channels: xyz(3) + 2d_coord(2) + region_attention(64) = 69
+    pnp_fc1_key = [k for k in state if k.startswith("pnp_net.fc1.weight")]
+    if pnp_fc1_key:
+        fc1_in = state[pnp_fc1_key[0]].shape[1]
+        # fc1_in = pnp_in_channel * final_h * final_w (default flatten with 1x1 spatial = featdim)
+        # For default: fc1_in = 1024, featdim=128, spatial=8→1 via 3 stride-2
+        # Actually: 3 stride-2 layers from 64→8, 8→4→2→1 ... wait.
+        # Input spatial is 64x64 (geo head output). But PnP net gets features at this resolution.
+        # Actually, PnP input is at 64x64 resolution, then 3 stride-2 conv → 8x8 → flatten = 128*8*8 = 8192
+        # fc1 should be 8192→1024. Let me check.
+        pass
+
+    # Detect pnp_net input channels from first conv weight
+    pnp_keys = [k for k in state if k.startswith("pnp_net.features.0.weight")]
+    if pnp_keys:
+        meta["pnp_in_channel"] = state[pnp_keys[0]].shape[1]
+    else:
+        meta["pnp_in_channel"] = 69  # 3 + 2 + 64
+
+    # Detect rot_dim from fc_r
+    fc_r_key = [k for k in state if k == "pnp_net.fc_r.weight"]
+    meta["rot_dim"] = state[fc_r_key[0]].shape[0] if fc_r_key else 6
+
+    return meta
+
+
+def _load_submodule(module, state_dict, prefix):
+    """Load weights for a submodule from full state_dict."""
+    sub_state = {}
+    for k, v in state_dict.items():
+        if k.startswith(prefix):
+            sub_state[k[len(prefix):]] = v
+    missing, unexpected = module.load_state_dict(sub_state, strict=False)
+    if missing:
+        logger.warning(f"Missing keys for {prefix}: {missing[:5]}...")
+    if unexpected:
+        logger.warning(f"Unexpected keys for {prefix}: {unexpected[:5]}...")
+    logger.info(f"Loaded {len(sub_state)} params for {prefix} (missing={len(missing)}, unexpected={len(unexpected)})")
+
+
+# ── Export functions ─────────────────────────────────────────────────────
+def make_dummy_inputs(batch_size=1, num_classes=8, device="cpu"):
+    """Create dummy inputs for tracing."""
+    image = torch.randn(batch_size, 3, 256, 256, device=device)
+    roi_classes = torch.zeros(batch_size, dtype=torch.int64, device=device)
+    roi_coord_2d = torch.randn(batch_size, 2, 64, 64, device=device)
+    roi_extents = torch.randn(batch_size, 3, device=device)
+    return image, roi_classes, roi_coord_2d, roi_extents
+
+
+def export_to_onnx(model, dummy_inputs, onnx_path):
+    """Export model to ONNX format."""
+    os.makedirs(os.path.dirname(onnx_path), exist_ok=True)
+    logger.info(f"Exporting to ONNX: {onnx_path}")
+
+    torch.onnx.export(
+        model,
+        dummy_inputs,
+        onnx_path,
+        opset_version=16,
+        input_names=["image", "roi_classes", "roi_coord_2d", "roi_extents"],
+        output_names=["pred_rot", "pred_t", "coor_x", "coor_y", "coor_z", "vis_mask"],
+        dynamic_axes={
+            "image": {0: "batch"},
+            "roi_classes": {0: "batch"},
+            "roi_coord_2d": {0: "batch"},
+            "roi_extents": {0: "batch"},
+            "pred_rot": {0: "batch"},
+            "pred_t": {0: "batch"},
+            "coor_x": {0: "batch"},
+            "coor_y": {0: "batch"},
+            "coor_z": {0: "batch"},
+            "vis_mask": {0: "batch"},
+        },
+        do_constant_folding=True,
+    )
+    logger.info(f"ONNX model saved to: {onnx_path}")
+
+    # simplify
+    try:
+        import onnx
+        from onnxsim import simplify
+        logger.info("Simplifying ONNX model...")
+        onnx_model = onnx.load(onnx_path)
+        simplified, ok = simplify(onnx_model)
+        if ok:
+            onnx.save(simplified, onnx_path)
+            logger.info("ONNX model simplified successfully")
+        else:
+            logger.warning("ONNX simplification failed, using original")
+    except ImportError:
+        logger.warning("onnxsim not installed, skipping simplification")
+
+
+def _set_shapes_and_names(ov_model, max_batch=16):
+    """Set bounded dynamic batch with static spatial dims, and name outputs.
+
+    The batch dimension is set to a bounded range [1, max_batch] so that
+    OpenVINO can optimize for this range while still allowing variable-size
+    batches at inference time (e.g. different numbers of detections per image).
+    Spatial dimensions remain fully static for maximum optimization.
+    """
+    import openvino as ov
+    B = ov.Dimension(1, max_batch)
+    ov_model.reshape({
+        "image": ov.PartialShape([B, 3, 256, 256]),
+        "roi_classes": ov.PartialShape([B]),
+        "roi_coord_2d": ov.PartialShape([B, 2, 64, 64]),
+        "roi_extents": ov.PartialShape([B, 3]),
+    })
+    # Name the outputs (otherwise they show as ***NO_NAME***)
+    output_names = ["pred_rot", "pred_t", "coor_x", "coor_y", "coor_z", "vis_mask"]
+    for output, name in zip(ov_model.outputs, output_names):
+        output.tensor.set_names({name})
+    return ov_model
+
+
+def export_onnx_to_openvino(onnx_path, output_dir, fp16=False, max_batch=16):
+    """Convert ONNX model to OpenVINO IR."""
+    import openvino as ov
+    logger.info(f"OpenVINO version: {ov.__version__}")
+    logger.info("Converting ONNX → OpenVINO IR...")
+
+    core = ov.Core()
+    ov_model = core.read_model(onnx_path)
+    ov_model = _set_shapes_and_names(ov_model, max_batch=max_batch)
+
+    xml_path = os.path.join(output_dir, "gdrn.xml")
+    if fp16:
+        logger.info("Compressing to FP16...")
+    ov.save_model(ov_model, xml_path, compress_to_fp16=fp16)
+    logger.info(f"OpenVINO IR saved: {xml_path}")
+    return ov_model
+
+
+def export_direct_to_openvino(model, dummy_inputs, output_dir, fp16=False, max_batch=16):
+    """Convert PyTorch model directly to OpenVINO IR."""
+    import openvino as ov
+    logger.info(f"OpenVINO version: {ov.__version__}")
+    logger.info("Converting PyTorch → OpenVINO IR directly...")
+
+    ov_model = ov.convert_model(
+        model,
+        example_input=dummy_inputs,
+    )
+    ov_model = _set_shapes_and_names(ov_model, max_batch=max_batch)
+    logger.info("Direct conversion successful")
+
+    xml_path = os.path.join(output_dir, "gdrn.xml")
+    if fp16:
+        logger.info("Compressing to FP16...")
+    ov.save_model(ov_model, xml_path, compress_to_fp16=fp16)
+    logger.info(f"OpenVINO IR saved: {xml_path}")
+    return ov_model
+
+
+def verify_models(pytorch_model, ov_model, dummy_inputs):
+    """Compare PyTorch vs OpenVINO outputs."""
+    import openvino as ov
+
+    logger.info("Verifying OpenVINO model against PyTorch...")
+
+    # PyTorch inference
+    pytorch_model.eval()
+    with torch.no_grad():
+        pt_outputs = pytorch_model(*dummy_inputs)
+    pt_names = ["pred_rot", "pred_t", "coor_x", "coor_y", "coor_z", "vis_mask"]
+    pt_np = {name: val.cpu().numpy() for name, val in zip(pt_names, pt_outputs)}
+
+    # OpenVINO inference
+    core = ov.Core()
+    if isinstance(ov_model, str):
+        ov_model = core.read_model(ov_model)
+    compiled = core.compile_model(ov_model, "CPU")
+    inputs = {
+        "image": dummy_inputs[0].cpu().numpy(),
+        "roi_classes": dummy_inputs[1].cpu().numpy(),
+        "roi_coord_2d": dummy_inputs[2].cpu().numpy(),
+        "roi_extents": dummy_inputs[3].cpu().numpy(),
+    }
+    ov_result = compiled(inputs)
+    ov_np = {name: ov_result[i] for i, name in enumerate(pt_names)}
+
+    # Compare all outputs
+    logger.info("Verification results:")
+    max_diff = 0.0
+    for name in pt_names:
+        diff_max = np.abs(pt_np[name] - ov_np[name]).max()
+        diff_mean = np.abs(pt_np[name] - ov_np[name]).mean()
+        logger.info(f"  {name:10s} - shape: PT {pt_np[name].shape} vs OV {ov_np[name].shape}, "
+                     f"max diff: {diff_max:.6f}, mean diff: {diff_mean:.6f}")
+        max_diff = max(max_diff, diff_max)
+
+    if max_diff < 1e-3:
+        logger.info("✅ Verification PASSED: Outputs match closely")
+    elif max_diff < 1e-2:
+        logger.warning("⚠️ Verification WARNING: Small differences detected")
+    else:
+        logger.error("❌ Verification FAILED: Large differences detected")
+
+    return max_diff
+
+
+# ── CLI ──────────────────────────────────────────────────────────────────
+def parse_args():
+    p = argparse.ArgumentParser(description="Export GDRN to OpenVINO")
+    p.add_argument("--ckpt", required=True, help="Path to checkpoint (.pth)")
+    p.add_argument("--output", required=True, help="Output directory")
+    p.add_argument("--convert-mode", default="pytorch-ov",
+                   choices=["pytorch-onnx-ov", "pytorch-ov"],
+                   help="Conversion path")
+    p.add_argument("--verify", action="store_true", help="Verify OV vs PyTorch")
+    p.add_argument("--fp16", action="store_true", help="Compress to FP16")
+    p.add_argument("--batch-size", type=int, default=1,
+                   help="Batch size for dummy inputs / tracing")
+    p.add_argument("--max-batch", type=int, default=8,
+                   help="Upper bound of dynamic batch dimension (default: 8)")
+    return p.parse_args()
+
+
+def main():
+    args = parse_args()
+
+    # Save log to output directory
+    os.makedirs(args.output, exist_ok=True)
+    log_path = os.path.join(args.output, "export.log")
+    logger.add(log_path, mode="w")
+
+    logger.info("=" * 60)
+    logger.info("GDRN to OpenVINO Export")
+    logger.info("=" * 60)
+    logger.info(f"Checkpoint: {args.ckpt}")
+    logger.info(f"Output: {args.output}")
+    logger.info(f"Conversion mode: {args.convert_mode}")
+
+    # Build model
+    model, meta = build_gdrn_from_checkpoint(args.ckpt)
+    model.cpu().eval()
+    logger.info(f"Model built: backbone={meta['backbone_name']}, "
+                f"classes={meta['num_classes']}, regions={meta['num_regions']}, "
+                f"rot_dim={meta['rot_dim']}, pnp_in={meta['pnp_in_channel']}")
+
+    # Dummy inputs
+    dummy = make_dummy_inputs(args.batch_size, meta["num_classes"])
+
+    # Test PyTorch
+    logger.info("Testing PyTorch model...")
+    with torch.no_grad():
+        rot, t, coor_x, coor_y, coor_z, vis_mask = model(*dummy)
+    logger.info(f"PyTorch output: rot={rot.shape}, t={t.shape}, "
+                f"coor_x={coor_x.shape}, coor_y={coor_y.shape}, coor_z={coor_z.shape}, "
+                f"vis_mask={vis_mask.shape}")
+
+    # Export
+    os.makedirs(args.output, exist_ok=True)
+    ov_model = None
+
+    if args.convert_mode == "pytorch-onnx-ov":
+        logger.info("Using PyTorch → ONNX → OpenVINO path")
+        onnx_path = os.path.join(args.output, "gdrn.onnx")
+        export_to_onnx(model, dummy, onnx_path)
+        ov_model = export_onnx_to_openvino(onnx_path, args.output, fp16=args.fp16, max_batch=args.max_batch)
+    else:
+        logger.info("Using PyTorch → OpenVINO direct path")
+        ov_model = export_direct_to_openvino(model, dummy, args.output, fp16=args.fp16, max_batch=args.max_batch)
+
+    # Verify
+    if args.verify:
+        verify_models(model, ov_model, dummy)
+
+    logger.info("=" * 60)
+    logger.info("✅ Export completed successfully!")
+    logger.info("=" * 60)
+    logger.info(f"OpenVINO IR: {args.output}/gdrn.xml + gdrn.bin")
+    if args.convert_mode == "pytorch-onnx-ov":
+        logger.info(f"ONNX intermediate: {args.output}/gdrn.onnx")
+    logger.info("")
+    logger.info(f"Exported model inputs (batch dim: 1..{args.max_batch}):")
+    logger.info("  image        : (B, 3, 256, 256) float32")
+    logger.info("  roi_classes  : (B,)             int64")
+    logger.info("  roi_coord_2d : (B, 2, 64, 64)  float32")
+    logger.info("  roi_extents  : (B, 3)           float32")
+    logger.info("Exported model outputs:")
+    logger.info(f"  pred_rot     : (B, {meta['rot_dim']})  float32  (allocentric 6D rotation)")
+    logger.info("  pred_t       : (B, 3)           float32  (centroid_x_rel, centroid_y_rel, z_rel)")
+    logger.info("  coor_x       : (B, 1, 64, 64)  float32  (predicted x coordinate map)")
+    logger.info("  coor_y       : (B, 1, 64, 64)  float32  (predicted y coordinate map)")
+    logger.info("  coor_z       : (B, 1, 64, 64)  float32  (predicted z coordinate map)")
+    logger.info("  vis_mask     : (B, 1, 64, 64)  float32  (predicted visibility mask)")
+    logger.info("")
+    logger.info("Post-processing (not in model):")
+    logger.info("  Direct path:  rot6d→R, centroid_z→translation, allo→ego")
+    logger.info("  PnP RANSAC:   coor_x/y/z + vis_mask → 2D-3D correspondences → cv2.solvePnPRansac")
+
+
+if __name__ == "__main__":
+    main()
