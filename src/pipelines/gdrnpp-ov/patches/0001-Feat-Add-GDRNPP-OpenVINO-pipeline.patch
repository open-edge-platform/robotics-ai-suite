new file mode 100644
index 0000000..f4ec625
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,168 @@
+# Dockerfile for GDRNPP with OpenVINO support
+# Base: Ubuntu 24.04 + PyTorch 2.x + OpenVINO
+
+FROM ubuntu:24.04
+
+# Avoid interactive prompts during build
+ENV DEBIAN_FRONTEND=noninteractive
+
+# Proxy settings (passed as build args)
+ARG http_proxy
+ARG https_proxy
+ARG no_proxy
+ENV http_proxy=${http_proxy}
+ENV https_proxy=${https_proxy}
+ENV no_proxy=${no_proxy}
+
+# Set working directory
+WORKDIR /workspace/gdrnpp
+
+# Install system dependencies
+RUN apt-get update && apt-get install -y --no-install-recommends \
+    # Basic build tools
+    build-essential \
+    cmake \
+    curl \
+    wget \
+    git \
+    pkg-config \
+    autoconf \
+    libtool \
+    clang \
+    ca-certificates \
+    # Python (Ubuntu 24.04 comes with Python 3.12)
+    python3 \
+    python3-dev \
+    python3-pip \
+    python3-venv \
+    # Image processing
+    libjpeg-dev \
+    zlib1g-dev \
+    libopenexr-dev \
+    openexr \
+    libglib2.0-0 \
+    # Graphics and rendering
+    libglfw3-dev \
+    libglfw3 \
+    libglew-dev \
+    libgles2 \
+    libgl1-mesa-dev \
+    libegl1-mesa-dev \
+    libgles2-mesa-dev \
+    libglvnd0 \
+    libgl1 \
+    libglx0 \
+    libegl1 \
+    libglvnd-dev \
+    # 3D processing
+    libassimp-dev \
+    # Math libraries (for uncertainty PnP)
+    libeigen3-dev \
+    libgoogle-glog-dev \
+    libsuitesparse-dev \
+    libatlas-base-dev \
+    # Other utilities
+    libnuma-dev \
+    vim \
+    gnupg \
+    && rm -rf /var/lib/apt/lists/*
+
+# Intel GPU runtime for OpenVINO GPU plugin and EGL rendering.
+#
+# Ubuntu 24.04 ships Mesa 24.x/25.x natively, new enough to recognise recent
+# Intel GPU PCI IDs. Intel's official installation guide uses the intel-graphics
+# Ubuntu PPA for current OpenCL / Level Zero compute runtimes.
+#
+# Packages:
+#   - intel-opencl-icd       : OpenCL compute runtime (NEO)
+#   - libze-intel-gpu1       : Level Zero GPU backend (new package name)
+#   - libze1                 : Level Zero loader (OpenVINO GPU defaults to L0)
+#   - intel-metrics-discovery: GPU performance metrics support
+#   - intel-gsc              : Intel graphics system controller firmware tools
+#   - ocl-icd-libopencl1     : OpenCL ICD loader
+#   - clinfo / mesa-utils    : diagnostic tools (eglinfo / glxinfo / clinfo)
+RUN apt-get update && apt-get install -y --no-install-recommends \
+        software-properties-common && \
+    add-apt-repository -y ppa:kobuk-team/intel-graphics && \
+    apt-get update && apt-get install -y --no-install-recommends \
+        intel-opencl-icd \
+        libze-intel-gpu1 \
+        libze1 \
+        intel-metrics-discovery \
+        intel-gsc \
+        ocl-icd-libopencl1 \
+        clinfo \
+        mesa-utils \
+    && rm -rf /var/lib/apt/lists/*
+
+# Install Python packages in a virtual environment. Ubuntu 24.04 marks its
+# system Python as externally managed (PEP 668).
+RUN python3 -m venv /opt/venv
+ENV PATH="/opt/venv/bin:${PATH}"
+
+# Upgrade pip and install basic Python packages. A current pybind11 is required
+# to build the EGL renderer against Python 3.12 after the source is mounted.
+# Pin setuptools<72 to keep pkg_resources (needed by legacy packages)
+RUN pip install --no-cache-dir --upgrade pip "setuptools<72" wheel "pybind11>=2.12"
+
+# Install PyTorch 2.14.0 (CPU-only version)
+RUN pip install --no-cache-dir \
+    torch==2.14.0 \
+    torchvision==0.29.0 \
+    --index-url https://download.pytorch.org/whl/cpu
+
+# Install OpenVINO 2026
+RUN pip install --no-cache-dir openvino==2026.4.0
+
+# Copy requirements and install Python dependencies
+# Remove packages incompatible with Python 3.12 + CPU-only PyTorch 2.14:
+#   mmcv-full  -> replaced with pure-Python mmcv 1.x (no ops are used)
+#   pytorch3d  -> no CPU wheel for py3.12, not needed for inference/export
+#   deepspeed  -> requires CUDA
+#   pyro-ppl   -> pinned version incompatible with PyTorch 2.14
+COPY requirements/requirements.txt /tmp/requirements.txt
+RUN sed -i '/^mmcv-full/d; /^pytorch3d/d; /^deepspeed/d; /^pyro-ppl/d' /tmp/requirements.txt && \
+    pip install --no-cache-dir -r /tmp/requirements.txt && \
+    pip install --no-cache-dir --no-build-isolation "mmcv==1.7.2"
+
+# Install pillow-simd for faster image processing
+RUN pip uninstall -y pillow && \
+    CC="cc -mavx2" pip install --no-cache-dir -U --force-reinstall pillow-simd
+
+# Install detectron2 from source (use --no-build-isolation to see installed torch)
+RUN pip install --no-cache-dir --no-build-isolation \
+    detectron2@git+https://github.com/facebookresearch/detectron2.git
+
+
+# CUDA extensions are not compiled. The Intel-compatible EGL renderer is built
+# by docker_build_run.sh after the source tree is mounted into the container.
+
+# Create non-root user matching host user (configurable via build args)
+# Pass HOST_UID and HOST_GID at build time so that files created inside
+# the container have the same owner as the host user.
+ARG HOST_UID=1000
+ARG HOST_GID=1000
+ARG HOST_USER=devuser
+RUN groupadd -g ${HOST_GID} ${HOST_USER} 2>/dev/null || true && \
+    useradd -m -u ${HOST_UID} -g ${HOST_GID} -s /bin/bash ${HOST_USER} 2>/dev/null || true
+
+# Set environment variables
+ENV PYTHONPATH="/workspace/gdrnpp:${PYTHONPATH}"
+ENV LD_LIBRARY_PATH="/usr/lib64:${LD_LIBRARY_PATH}"
+
+# Create directories for models and outputs, owned by the host user
+RUN mkdir -p /workspace/gdrnpp/pretrained_models/yolox && \
+    mkdir -p /workspace/gdrnpp/output && \
+    mkdir -p /workspace/gdrnpp/datasets && \
+    chown -R ${HOST_UID}:${HOST_GID} /workspace/gdrnpp
+
+# Switch to host user
+USER ${HOST_UID}:${HOST_GID}
+
+# Set default command
+CMD ["/bin/bash"]
+
+# Optional: Add labels for metadata
+LABEL maintainer="GDRNPP OpenVINO Migration"
+LABEL description="GDRNPP with PyTorch 2.14 (CPU) and OpenVINO 2026 for 6D pose estimation on Intel GPU"
+LABEL version="1.0-openvino-gpu"
