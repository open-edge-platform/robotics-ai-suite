+#!/usr/bin/env python3
+"""
+Evaluate GDRNPP OpenVINO pipeline on BOP dataset (e.g. LMO).
+
+Runs the full pipeline (YOLOX detection → GDRN pose estimation) on all test
+images, saves predictions in BOP CSV format, then calls the BOP evaluation
+script to compute standard metrics (ADD, VSD, MSSD, MSPD, etc.).
+
+Runtime dependencies are listed in requirements/requirements_deploy.txt.
+PyTorch, torchvision, mmcv and detectron2 are not required for inference.
+
+Usage:
+    python tools/openvino/eval_openvino.py \
+        --yolox-model models/openvino/yolox_lmo_direct/yolox.xml \
+        --gdrn-model models/openvino/gdrn_lmo_6out_direct/gdrn.xml \
+        --dataset-dir datasets/BOP_DATASETS/lmo \
+        --output eval_output/lmo_openvino
+"""
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+# Add tools/ to path so infer_utils can be found
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from gdrnpp_ov_pipeline import GDRNPPPipeline
+
+
+# ── LMO dataset constants ──────────────────────────────────────────────────
+# Class-index convention: cls_id in [0, 7] maps to obj_id via LMO_OBJ_IDS.
+LMO_OBJ_IDS = [1, 5, 6, 8, 9, 10, 11, 12]
+LMO_OBJ_NAMES = ["ape", "can", "cat", "driller", "duck", "eggbox", "glue", "holepuncher"]
+
+# Default LMO camera intrinsics (used when scene_camera.json is unavailable —
+# normally the eval loop overrides pipeline.cam_K per image).
+LMO_DEFAULT_K = np.array([
+    [572.4114, 0.0, 325.2611],
+    [0.0, 573.57043, 242.04899],
+    [0.0, 0.0, 1.0],
+], dtype=np.float32)
+
+
+def load_extents(models_info_path, obj_ids, scale_to_meter=0.001):
+    """Load 3D object extents from BOP models_info.json, keyed by cls_id."""
+    with open(models_info_path) as f:
+        models_info = json.load(f)
+    extents = {}
+    for cls_idx, obj_id in enumerate(obj_ids):
+        info = models_info[str(obj_id)]
+        extents[cls_idx] = np.array([
+            info["size_x"] * scale_to_meter,
+            info["size_y"] * scale_to_meter,
+            info["size_z"] * scale_to_meter,
+        ], dtype=np.float32)
+    return extents
+
+
+def load_scene_data(dataset_dir, scene_id):
+    """Load scene ground truth and camera data."""
+    scene_dir = os.path.join(dataset_dir, "test", f"{scene_id:06d}")
+    with open(os.path.join(scene_dir, "scene_camera.json")) as f:
+        scene_camera = json.load(f)
+    with open(os.path.join(scene_dir, "scene_gt.json")) as f:
+        scene_gt = json.load(f)
+    return scene_camera, scene_gt
+
+
+def format_rotation(R):
+    """Format 3x3 rotation matrix as space-separated string (row-major)."""
+    return " ".join(f"{v}" for v in R.flatten().tolist())
+
+
+def format_translation(t):
+    """Format translation vector as space-separated string (in mm)."""
+    # Pipeline outputs in meters, BOP expects mm
+    t_mm = t * 1000.0
+    return " ".join(f"{v}" for v in t_mm.flatten().tolist())
+
+
+def run_evaluation(args):
+    dataset_dir = args.dataset_dir
+    project_root = Path(__file__).resolve().parent.parent.parent
+
+    os.makedirs(args.output, exist_ok=True)
+    args_path = os.path.join(args.output, "eval_args.json")
+    with open(args_path, "w") as f:
+        json.dump(vars(args), f, indent=2, sort_keys=True)
+        f.write("\n")
+    print(f"Saved evaluation arguments: {args_path}")
+
+    # Load test targets
+    targets_path = os.path.join(dataset_dir, "lmo", "test_targets_bop19.json")
+    if not os.path.exists(targets_path):
+        targets_path = os.path.join(dataset_dir, "test_targets_bop19.json")
+    with open(targets_path) as f:
+        targets = json.load(f)
+    print(f"Loaded {len(targets)} evaluation targets")
+
+    # Group targets by (scene_id, im_id)
+    target_map = {}
+    for t in targets:
+        key = (t["scene_id"], t["im_id"])
+        if key not in target_map:
+            target_map[key] = []
+        target_map[key].append(t["obj_id"])
+
+    # Unique images to process
+    image_keys = sorted(target_map.keys())
+    print(f"Unique images: {len(image_keys)}")
+
+    # Load extents
+    models_info_path = os.path.join(dataset_dir, "models", "models_info.json")
+    extents = load_extents(models_info_path, obj_ids=LMO_OBJ_IDS)
+    obj_id_to_cls = {oid: cls for cls, oid in enumerate(LMO_OBJ_IDS)}
+
+    # Build model PLY paths if depth refinement is enabled
+    ply_paths = None
+    if args.depth_refine:
+        models_dir = os.path.join(dataset_dir, "models")
+        print(f"Loading 3D model paths for depth refinement: {models_dir}")
+        ply_paths = {}
+        for cls_idx, obj_id in enumerate(LMO_OBJ_IDS):
+            ply_paths[cls_idx] = os.path.join(models_dir, f"obj_{obj_id:06d}.ply")
+
+    # Load pre-computed detections if provided
+    det_data = None
+    if args.det_file:
+        print(f"Loading pre-computed detections: {args.det_file}")
+        with open(args.det_file) as f:
+            det_data = json.load(f)
+        total_dets = sum(len(v) for v in det_data.values())
+        print(f"  {len(det_data)} images, {total_dets} total detections")
+    elif args.yolox_model is None:
+        print("Error: --yolox-model is required when --det-file is not provided")
+        sys.exit(1)
+
+    # Build pipeline. cam_K is a placeholder — the eval loop overrides
+    # pipeline.cam_K per image using each scene's scene_camera.json.
+    pipeline = GDRNPPPipeline(
+        yolox_model_path=args.yolox_model,
+        gdrn_model_path=args.gdrn_model,
+        extents=extents,
+        cam_K=LMO_DEFAULT_K,
+        device=args.device,
+        num_classes=args.num_classes,
+        conf_thr=args.conf_thr,
+        nms_thr=args.nms_thr,
+        use_pnp=args.use_pnp,
+        mask_thr=args.mask_thr,
+        depth_refine=args.depth_refine,
+        ply_paths=ply_paths,
+        refine_iter=args.refine_iter,
+        refine_thr=args.refine_thr,
+        enable_profiling=args.profile,
+    )
+
+    # Run inference on all images
+    results = []
+    scene_cameras = {}
+    total_time = 0.0
+
+    # Per-image timing log (only populated if --profile is enabled)
+    timing_rows = []
+    prev_snapshot = {}
+
+    for idx, (scene_id, im_id) in enumerate(image_keys):
+        # Load camera data (cached per scene)
+        if scene_id not in scene_cameras:
+            scene_cameras[scene_id], _ = load_scene_data(dataset_dir, scene_id)
+
+        cam_data = scene_cameras[scene_id][str(im_id)]
+        cam_K = np.array(cam_data["cam_K"], dtype=np.float32).reshape(3, 3)
+        pipeline.cam_K = cam_K
+
+        # Load image
+        img_path = os.path.join(
+            dataset_dir, "test", f"{scene_id:06d}", "rgb", f"{im_id:06d}.png"
+        )
+        image = cv2.imread(img_path)
+        if image is None:
+            print(f"Warning: cannot read {img_path}, skipping")
+            continue
+
+        # Load depth image if depth refinement is enabled
+        depth_image = None
+        if args.depth_refine:
+            depth_path = os.path.join(
+                dataset_dir, "test", f"{scene_id:06d}", "depth", f"{im_id:06d}.png"
+            )
+            depth_raw = cv2.imread(depth_path, cv2.IMREAD_UNCHANGED)
+            if depth_raw is not None:
+                depth_scale = cam_data.get("depth_scale", 1.0)
+                depth_image = depth_raw.astype(np.float32) * depth_scale * 0.001  # to meters
+            else:
+                print(f"Warning: cannot read depth {depth_path}")
+
+        # Run pipeline
+        t0 = time.perf_counter()
+        if det_data is not None:
+            # Use pre-computed bboxes (matches load_detections_into_dataset logic)
+            scene_im_key = f"{scene_id}/{im_id}"
+            bbox_list = det_data.get(scene_im_key, [])
+            target_objs = target_map[(scene_id, im_id)]
+            # Group by obj_id, keep top-1 per object (matches DET_TOPK_PER_OBJ=1)
+            obj_best = {}
+            for d in bbox_list:
+                oid = d["obj_id"]
+                if oid not in target_objs:
+                    continue
+                score = d.get("score", 1.0)
+                if score < args.det_score_thr:
+                    continue
+                if oid not in obj_best or score > obj_best[oid].get("score", 0):
+                    obj_best[oid] = d
+            # Translate BOP obj_id -> GDRN class_id; drop entries outside the
+            # LMO class set (the pipeline itself is now dataset-agnostic).
+            bbox_for_pipeline = []
+            for d in obj_best.values():
+                cls_id = obj_id_to_cls.get(d["obj_id"])
+                if cls_id is None:
+                    continue
