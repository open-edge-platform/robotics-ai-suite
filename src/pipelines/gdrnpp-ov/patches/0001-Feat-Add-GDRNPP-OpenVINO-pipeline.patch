+
+    print(f"\nInference done: {len(results)} predictions from {len(image_keys)} images")
+    print(f"Total time: {total_time:.1f}s, avg: {total_time/len(image_keys)*1000:.1f}ms/image")
+
+    profiling_report = pipeline.profiler.report()
+    if profiling_report:
+        report_path = os.path.join(args.output, "profiling_report.txt")
+        with open(report_path, "w") as f:
+            f.write(profiling_report + "\n")
+        print(f"Saved profiling report: {report_path}")
+
+    # Save per-image timing CSV
+    if args.profile and timing_rows:
+        all_keys = set()
+        for r in timing_rows:
+            all_keys.update(r.keys())
+        fixed = ["scene_id", "im_id", "n_objects", "wall_s"]
