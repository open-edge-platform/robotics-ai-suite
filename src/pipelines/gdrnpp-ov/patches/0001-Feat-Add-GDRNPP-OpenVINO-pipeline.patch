+        ]
+        print(f"\nRunning BOP evaluation...")
+        print(f"Command: {' '.join(eval_cmd)}")
+        pid = os.posix_spawn(sys.executable, eval_cmd, os.environ)
+        _, status = os.waitpid(pid, 0)
+        ret = os.waitstatus_to_exitcode(status)
+        if ret != 0:
+            print("Warning: BOP evaluation returned non-zero exit code")
+        else:
