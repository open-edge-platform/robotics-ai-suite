+
+    image_keys = sorted(target_map.keys())
+    print(f"Unique images: {len(image_keys)}")
+
+    # Load extents
+    models_info_path = os.path.join(dataset_dir, "models", "models_info.json")
+    extents = load_extents(models_info_path, obj_ids=LMO_OBJ_IDS)
+
+    # Build YOLOX PyTorch model
+    print("Loading YOLOX PyTorch model...")
+    num_classes = detect_num_classes(args.yolox_ckpt)
+    if num_classes is None:
+        num_classes = args.num_classes + 1  # +1 for background
+    yolox_model = load_yolox_model(
+        args.yolox_ckpt,
+        depth=args.yolox_depth, width=args.yolox_width,
+        num_classes=num_classes, device="cpu",
+    )
+    yolox_model.eval()
+
+    # Build GDRN PyTorch model
+    print("Loading GDRN PyTorch model...")
+    gdrn_model, meta = build_gdrn_from_checkpoint(args.gdrn_ckpt)
+    gdrn_model.cpu().eval()
+
+    # Detect YOLOX input size from model (default 640x640)
+    yolox_input_size = (640, 640)
+
+    # Build pipeline
+    pipeline = GDRNPPPipelinePyTorch(
+        yolox_model=yolox_model,
+        gdrn_model=gdrn_model,
+        extents=extents,
+        cam_K=LMO_DEFAULT_K,
+        yolox_input_size=yolox_input_size,
+        num_classes=args.num_classes,
+        conf_thr=args.conf_thr,
+        nms_thr=args.nms_thr,
+        use_pnp=args.use_pnp,
+        mask_thr=args.mask_thr,
+    )
+
+    # Run inference
+    results = []
+    scene_cameras = {}
+    total_time = 0.0
+
+    for idx, (scene_id, im_id) in enumerate(image_keys):
+        if scene_id not in scene_cameras:
+            scene_cameras[scene_id] = load_scene_data(dataset_dir, scene_id)
+
+        cam_data = scene_cameras[scene_id][str(im_id)]
+        cam_K = np.array(cam_data["cam_K"], dtype=np.float32).reshape(3, 3)
+        pipeline.cam_K = cam_K
+
+        img_path = os.path.join(
+            dataset_dir, "test", f"{scene_id:06d}", "rgb", f"{im_id:06d}.png"
+        )
+        image = cv2.imread(img_path)
+        if image is None:
+            print(f"Warning: cannot read {img_path}, skipping")
+            continue
+
+        t0 = time.perf_counter()
+        poses = pipeline(image)
+        elapsed = time.perf_counter() - t0
+        total_time += elapsed
+
+        target_objs = target_map[(scene_id, im_id)]
+        for pose in poses:
+            cls_id = pose["class_id"]
+            if not 0 <= cls_id < len(LMO_OBJ_IDS):
+                continue
+            obj_id = LMO_OBJ_IDS[cls_id]
+            if obj_id not in target_objs:
+                continue
+            results.append({
+                "scene_id": scene_id,
+                "im_id": im_id,
+                "obj_id": obj_id,
+                "score": pose["score"],
+                "R": format_rotation(pose["R"]),
+                "t": format_translation(pose["t"]),
+                "time": f"{elapsed:.4f}",
+            })
+
+        if (idx + 1) % 20 == 0 or idx == len(image_keys) - 1:
+            print(f"[{idx+1}/{len(image_keys)}] {len(results)} predictions, "
+                  f"avg {total_time/(idx+1)*1000:.1f}ms/image")
+
+    print(f"\nInference done: {len(results)} predictions from {len(image_keys)} images")
+    print(f"Total time: {total_time:.1f}s, avg: {total_time/len(image_keys)*1000:.1f}ms/image")
+
+    # Save BOP CSV
+    os.makedirs(args.output, exist_ok=True)
+    csv_name = "gdrnpp-pytorch_lmo-test.csv"
+    csv_path = os.path.join(args.output, csv_name)
+
+    header = "scene_id,im_id,obj_id,score,R,t,time"
+    with open(csv_path, "w") as f:
+        f.write(header + "\n")
+        for r in results:
+            line = ",".join(str(r[k]) for k in header.split(","))
+            f.write(line + "\n")
+    print(f"Saved predictions: {csv_path}")
+
+    # Run BOP evaluation
+    if not args.save_only:
+        eval_script = str(project_root / "lib" / "pysixd" / "scripts" / "eval_pose_results_more.py")
+        if not os.path.exists(eval_script):
+            print(f"Warning: eval script not found at {eval_script}")
+            return
+
+        eval_cmd = [
+            sys.executable, eval_script,
+            f"--results_path={args.output}",
+            f"--result_filenames={csv_name}",
+            f"--targets_filename=test_targets_bop19.json",
+            f"--error_types={args.error_types}",
+            f"--renderer_type=cpp",
+            f"--n_top=1",
+            f"--eval_path={args.output}",
+        ]
+        print(f"\nRunning BOP evaluation...")
+        pid = os.posix_spawn(sys.executable, eval_cmd, os.environ)
+        _, status = os.waitpid(pid, 0)
+        ret = os.waitstatus_to_exitcode(status)
+        if ret != 0:
+            print("Warning: BOP evaluation returned non-zero exit code")
+
+
+def parse_args():
+    p = argparse.ArgumentParser(description="Evaluate GDRNPP PyTorch on BOP dataset")
+    p.add_argument("--yolox-ckpt", required=True, help="YOLOX checkpoint (.pth)")
+    p.add_argument("--gdrn-ckpt", required=True, help="GDRN checkpoint (.pth)")
+    p.add_argument("--dataset-dir", default="datasets/BOP_DATASETS/lmo")
+    p.add_argument("--output", default="eval_output/lmo_pytorch")
+    p.add_argument("--num-classes", type=int, default=8)
+    p.add_argument("--yolox-depth", type=float, default=1.33, help="YOLOX depth (1.33 for X)")
+    p.add_argument("--yolox-width", type=float, default=1.25, help="YOLOX width (1.25 for X)")
+    p.add_argument("--conf-thr", type=float, default=0.3)
+    p.add_argument("--nms-thr", type=float, default=0.45)
+    p.add_argument("--use-pnp", action="store_true", default=True)
+    p.add_argument("--no-pnp", dest="use_pnp", action="store_false")
+    p.add_argument("--mask-thr", type=float, default=0.5)
+    p.add_argument("--error-types", default="ad,reteS,reS,teS")
+    p.add_argument("--save-only", action="store_true")
+    return p.parse_args()
+
+
+if __name__ == "__main__":
+    args = parse_args()
+    run_evaluation(args)
